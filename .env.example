PUBLIC_COMPANY_NAME=Your Company

# Public origin of the careers site (links, metadata). Must match how candidates reach the app.
# Local dev (pnpm dev): http://localhost:4321
# Production behind TLS: https://careers.example.com
# Docker image build: set this before `docker compose ... build` so Astro trusts your public host (form POST / security.allowedDomains).
PUBLIC_SITE_URL=http://localhost:4321

# PocketBase URL for the Astro server (SSR and API routes only — not exposed to browsers as JS config).
# Local dev (pnpm dev): http://127.0.0.1:8090
# Docker production (web container → pocketbase service): http://pocketbase:8090 (set automatically in docker-compose.prod.yml unless overridden)
POCKETBASE_URL=http://127.0.0.1:8090

# Docker production only: hostname Caddy uses for the careers site block (no scheme). DNS A/AAAA must point at the host; ports 80/443 open for Let's Encrypt.
# Example: careers.example.com
# SITE_HOST=

# Optional: second Caddy site for PocketBase Admin at https://<this-host>/_/ (DNS must point at this server). Leave unset to omit (admin via SSH tunnel to 127.0.0.1:8090 only).
# Example (CNAME to careers host in Cloudflare): admin-careers.example.com
# POCKETBASE_ADMIN_HOST=

# Astro server: dedicated PocketBase auth user (submission_service). Never use the superuser in the web app.
# If POCKETBASE_SUBMISSION_SERVICE_PASSWORD (≥10 chars) is set when PocketBase starts, the migration seeds this user automatically.
POCKETBASE_SUBMISSION_SERVICE_EMAIL=application-service@internal.local
POCKETBASE_SUBMISSION_SERVICE_PASSWORD=change-me-long-random

# PocketBase /_/ UI only — not read by the Astro app.
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

RESEND_API_KEY=re_placeholder
# Display name + angle-bracket email must be quoted (spaces / < > break shell if .env is sourced).
APPLICATION_EMAIL_FROM="minihire <jobs@example.com>"
APPLICATION_EMAIL_REPLY_TO=jobs@example.com
MAX_CV_SIZE_BYTES=5242880
FORM_SIGNING_SECRET=replace-with-a-long-random-secret
