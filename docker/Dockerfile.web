FROM node:20-bookworm-slim

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json

RUN pnpm install --frozen-lockfile

COPY apps/web ./apps/web

# Only non-secret values used at Astro build time (inlined for `PUBLIC_*` / SSR public config).
# Secrets (RESEND_API_KEY, FORM_SIGNING_SECRET, submission_service password, etc.) are read at
# **container runtime** via `process.env` — set them in compose `env_file` / `environment`, not here.
ARG PUBLIC_SITE_URL=
ARG PUBLIC_COMPANY_NAME=
ARG MAX_CV_SIZE_BYTES=

ENV PUBLIC_SITE_URL=${PUBLIC_SITE_URL}
ENV PUBLIC_COMPANY_NAME=${PUBLIC_COMPANY_NAME}
ENV MAX_CV_SIZE_BYTES=${MAX_CV_SIZE_BYTES}

RUN pnpm --filter web build

WORKDIR /app/apps/web

EXPOSE 4321

CMD ["node", "dist/server/entry.mjs"]
