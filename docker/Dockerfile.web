FROM node:20-bookworm-slim

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json

RUN pnpm install --frozen-lockfile

COPY apps/web ./apps/web

# Astro inlines `import.meta.env.*` at build time for SSR — these must exist during `pnpm build`,
# not only at container runtime (see tmp/minihire-production-fixes.md).
ARG PUBLIC_SITE_URL=
ARG PUBLIC_COMPANY_NAME=
ARG POCKETBASE_URL=
ARG POCKETBASE_SUBMISSION_SERVICE_EMAIL=
ARG POCKETBASE_SUBMISSION_SERVICE_PASSWORD=
ARG FORM_SIGNING_SECRET=
ARG RESEND_API_KEY=
ARG APPLICATION_EMAIL_FROM=
ARG APPLICATION_EMAIL_REPLY_TO=
ARG APPLICATION_EMAIL_SIGN_OFF=
ARG MAX_CV_SIZE_BYTES=

ENV PUBLIC_SITE_URL=${PUBLIC_SITE_URL}
ENV PUBLIC_COMPANY_NAME=${PUBLIC_COMPANY_NAME}
ENV POCKETBASE_URL=${POCKETBASE_URL}
ENV POCKETBASE_SUBMISSION_SERVICE_EMAIL=${POCKETBASE_SUBMISSION_SERVICE_EMAIL}
ENV POCKETBASE_SUBMISSION_SERVICE_PASSWORD=${POCKETBASE_SUBMISSION_SERVICE_PASSWORD}
ENV FORM_SIGNING_SECRET=${FORM_SIGNING_SECRET}
ENV RESEND_API_KEY=${RESEND_API_KEY}
ENV APPLICATION_EMAIL_FROM=${APPLICATION_EMAIL_FROM}
ENV APPLICATION_EMAIL_REPLY_TO=${APPLICATION_EMAIL_REPLY_TO}
ENV APPLICATION_EMAIL_SIGN_OFF=${APPLICATION_EMAIL_SIGN_OFF}
ENV MAX_CV_SIZE_BYTES=${MAX_CV_SIZE_BYTES}

RUN pnpm --filter web build

WORKDIR /app/apps/web

EXPOSE 4321

CMD ["node", "dist/server/entry.mjs"]
