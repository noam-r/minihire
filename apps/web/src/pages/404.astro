---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageTitle } from "../lib/site";
---

<BaseLayout title={getPageTitle("Not Found")} description="The requested page could not be found.">
  <section class="mx-auto max-w-2xl rounded-2xl border border-slate-200 bg-white p-10 text-center shadow-sm">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">Page not found</h1>
    <p class="mt-3 text-base leading-7 text-slate-600">
      The role or page you requested could not be found, or it is no longer published.
    </p>
    <div class="mt-6 flex justify-center gap-4">
      <a
        class="btn-primary btn-md"
        href="/jobs"
      >
        View jobs
      </a>
      <a
        class="btn-secondary btn-md"
        href="/"
      >
        Home
      </a>
    </div>
  </section>
</BaseLayout>
