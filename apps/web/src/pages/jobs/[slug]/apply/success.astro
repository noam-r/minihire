---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {
  applicationReceivedClosingLine,
  applicationReceivedConfirmationLine,
  applicationReceivedFollowUpParagraph,
} from "../../../../lib/application-received-copy";
import { getPublishedJobBySlug } from "../../../../lib/jobs";
import { getPageTitle } from "../../../../lib/site";

const slug = Astro.params.slug ?? "";
const job = slug ? await getPublishedJobBySlug(slug) : null;
const jobTitle = job?.title ?? "this role";
---

<BaseLayout
  title={getPageTitle("Application received")}
  description={`Thank you for applying for the ${jobTitle}.`}
>
  <section class="mx-auto max-w-2xl rounded-2xl border border-slate-200 bg-white p-10 shadow-sm">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">Application received</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">
      Thank you for applying for the {jobTitle} role.
    </h1>
    <p class="mt-4 text-base leading-7 text-slate-600">
      {applicationReceivedConfirmationLine}
    </p>
    <p class="mt-4 text-base leading-7 text-slate-600">
      {applicationReceivedFollowUpParagraph}
    </p>
    <p class="mt-4 text-base font-medium text-slate-800">
      {applicationReceivedClosingLine}
    </p>
    <div class="mt-6 flex flex-wrap gap-4">
      {
        job ? (
          <a class="btn-primary btn-md" href={`/jobs/${job.slug}`}>
            Back to job
          </a>
        ) : (
          <a class="btn-primary btn-md" href="/jobs">
            Browse jobs
          </a>
        )
      }
      <a class="btn-secondary btn-md" href="/jobs">
        All openings
      </a>
    </div>
  </section>
</BaseLayout>
