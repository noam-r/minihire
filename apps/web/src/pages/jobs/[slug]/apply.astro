---
import ApplicationForm from "../../../components/ApplicationForm.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublishedJobBySlug } from "../../../lib/jobs";
import { getPageTitle } from "../../../lib/site";
import { createSignedFormState } from "../../../lib/spam";
import { getMaxCvSizeBytes } from "../../../lib/validation";

const slug = Astro.params.slug ?? "";
const job = await getPublishedJobBySlug(slug);

if (!job) {
  Astro.response.status = 404;
}

const signedFormState = job ? createSignedFormState(job.slug) : null;
const maxCvSizeBytes = getMaxCvSizeBytes();
---

<BaseLayout
  title={job ? getPageTitle(`Apply | ${job.title}`) : getPageTitle("Role Not Found")}
  description={job?.summary ?? "This role could not be found or is no longer published."}
>
  {
    job && signedFormState ? (
      <section class="mx-auto max-w-3xl space-y-8">
        <div class="space-y-3">
          <a
            class="inline-flex items-center text-sm font-medium text-sky-700 hover:text-sky-900"
            href={`/jobs/${job.slug}`}
          >
            View job description
          </a>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">Apply</p>
          <h1 class="text-4xl font-semibold tracking-tight text-slate-900">
            Apply for {job.title}
          </h1>
          <p class="text-base leading-7 text-slate-600">
            Please complete the form below and upload your CV. You do not need to create an
            account.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <ApplicationForm
            jobSlug={job.slug}
            formStartedAt={signedFormState.startedAt}
            formSignature={signedFormState.signature}
            maxCvSizeBytes={maxCvSizeBytes}
          />
        </div>
      </section>
    ) : (
      <section class="mx-auto max-w-2xl rounded-2xl border border-slate-200 bg-white p-10 text-center shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">404</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">Role not found</h1>
        <p class="mt-3 text-base leading-7 text-slate-600">
          This role does not exist or is no longer published.
        </p>
        <a
          class="btn-primary btn-md mt-6"
          href="/jobs"
        >
          View jobs
        </a>
      </section>
    )
  }
</BaseLayout>
