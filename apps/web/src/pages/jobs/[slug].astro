---
import MarkdownContent from "../../components/MarkdownContent.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatEmploymentType,
  formatWorkModel,
  getPublishedJobBySlug,
} from "../../lib/jobs";
import { getPageTitle } from "../../lib/site";

const slug = Astro.params.slug ?? "";
const job = await getPublishedJobBySlug(slug);

if (!job) {
  Astro.response.status = 404;
}
---

<BaseLayout
  title={job ? getPageTitle(job.title) : getPageTitle("Role Not Found")}
  description={job?.summary ?? "This role could not be found or is no longer published."}
>
  {
    job ? (
      <article class="mx-auto max-w-3xl space-y-10">
        <header class="space-y-5">
          <div class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
            <span class="rounded-full bg-sky-50 px-3 py-1 font-medium text-sky-700">
              {formatWorkModel(job.workModel)}
            </span>
            <span>{formatEmploymentType(job.employmentType)}</span>
            {job.workLocation && <span>{job.workLocation}</span>}
          </div>

          <div class="space-y-3">
            <h1 class="text-4xl font-semibold tracking-tight text-slate-900">{job.title}</h1>
            <p class="text-base leading-7 text-slate-600">{job.summary}</p>
          </div>

          <div class="flex flex-wrap gap-4">
            <a
              class="btn-primary btn-md"
              href={`/jobs/${job.slug}/apply`}
            >
              Apply for this role
            </a>
            <a
              class="btn-secondary btn-md"
              href="/jobs"
            >
              Back to jobs
            </a>
          </div>
        </header>

        <section class="space-y-3">
          <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Job description</h2>
          <MarkdownContent content={job.description} />
        </section>

        {
          job.whatToExpect && (
            <section class="space-y-3">
              <h2 class="text-2xl font-semibold tracking-tight text-slate-900">What to expect</h2>
              <MarkdownContent content={job.whatToExpect} />
            </section>
          )
        }

        {
          job.requiredSkills.length > 0 && (
            <section class="space-y-3">
              <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Required skills</h2>
              <ul class="space-y-2 text-base leading-7 text-slate-700">
                {job.requiredSkills.map((skill) => (
                  <li class="rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
                    {skill}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          job.niceToHaveSkills.length > 0 && (
            <section class="space-y-3">
              <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Nice to have</h2>
              <ul class="space-y-2 text-base leading-7 text-slate-700">
                {job.niceToHaveSkills.map((skill) => (
                  <li class="rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
                    {skill}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          job.hiringProcess && (
            <section class="space-y-3">
              <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Hiring process</h2>
              <MarkdownContent content={job.hiringProcess} />
            </section>
          )
        }

        <aside class="rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm leading-6 text-amber-900">
          Because we are a small team, we may not be able to respond personally to every
          application.
        </aside>
      </article>
    ) : (
      <section class="mx-auto max-w-2xl rounded-2xl border border-slate-200 bg-white p-10 text-center shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">404</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">Role not found</h1>
        <p class="mt-3 text-base leading-7 text-slate-600">
          This role does not exist or is no longer published.
        </p>
        <a
          class="btn-primary btn-md mt-6"
          href="/jobs"
        >
          View jobs
        </a>
      </section>
    )
  }
</BaseLayout>
