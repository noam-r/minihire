---
import RecruiterLayout from "../../../layouts/RecruiterLayout.astro";
import { APPLICATION_STATUSES } from "../../../lib/application-statuses";
import { recruiterApplicationDetailErrors } from "../../../lib/recruiter-flash";
import { ensureSessionCsrfCookie } from "../../../lib/recruiter-auth/cookies";
import { formatRelativeTime } from "../../../lib/relative-time";
import { getCompanyName } from "../../../lib/site";

export const prerender = false;

const id = Astro.params.id;
if (!id) {
  return Astro.redirect("/recruiter/applications");
}

const { pb } = Astro.locals.recruiter!;
const csrf = ensureSessionCsrfCookie(Astro.cookies);
const companyName = getCompanyName();
const now = new Date();

const flash = {
  updated: Astro.url.searchParams.get("updated") === "1",
  note: Astro.url.searchParams.get("note") === "1",
  error: Astro.url.searchParams.get("error"),
};

const errorMsg = flash.error ? recruiterApplicationDetailErrors[flash.error] : undefined;

let record;
try {
  record = await pb.collection("applications").getOne(id, { expand: "job" });
} catch {
  return Astro.redirect("/recruiter/applications");
}

/** PocketBase list API rejects `sort` on system fields like `created` (400); sort in memory instead. */
function compareByCreatedThenId(
  a: { id: string; created?: string },
  b: { id: string; created?: string },
): number {
  const ta = Date.parse(String(a.created ?? ""));
  const tb = Date.parse(String(b.created ?? ""));
  if (Number.isFinite(ta) && Number.isFinite(tb) && ta !== tb) {
    return ta - tb;
  }
  return a.id.localeCompare(b.id);
}

const [notesRaw, historyRaw] = await Promise.all([
  pb.collection("application_notes").getFullList({
    filter: pb.filter("application = {:aid}", { aid: id }),
    requestKey: `recruiter_app_detail_notes_${id}`,
  }),
  pb.collection("application_status_history").getFullList({
    filter: pb.filter("application = {:aid}", { aid: id }),
    requestKey: `recruiter_app_detail_history_${id}`,
  }),
]);

const notes = [...notesRaw].sort(compareByCreatedThenId);
const history = [...historyRaw].sort((a, b) => compareByCreatedThenId(b, a));

const job = record.expand?.job as { title?: string; slug?: string } | undefined;
---

<RecruiterLayout title={`${record.full_name} | ${companyName}`}>
  <p class="text-sm text-slate-600">
    <a class="text-teal-800 hover:text-teal-900" href="/recruiter/applications">← Applications</a>
    <span class="mx-2 text-slate-300">|</span>
    <a class="text-teal-800 hover:text-teal-900" href="/recruiter/jobs">Jobs</a>
  </p>
  <h1 class="mt-2 text-2xl font-semibold text-slate-900">{record.full_name}</h1>
  <p class="text-sm text-slate-600">{job?.title ?? "Application"}</p>

  {
    flash.updated && (
      <p class="mt-4 rounded-md border border-teal-200 bg-teal-50 px-3 py-2 text-sm text-teal-900">Status updated.</p>
    )
  }
  {
    flash.note && (
      <p class="mt-4 rounded-md border border-teal-200 bg-teal-50 px-3 py-2 text-sm text-teal-900">Note added.</p>
    )
  }
  {
    errorMsg && (
      <p class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900">{errorMsg}</p>
    )
  }

  <dl class="mt-8 grid max-w-xl gap-3 text-sm">
    <div class="flex justify-between gap-4 border-b border-slate-100 py-2">
      <dt class="text-slate-500">Email</dt>
      <dd class="text-slate-900">{record.email}</dd>
    </div>
    <div class="flex justify-between gap-4 border-b border-slate-100 py-2">
      <dt class="text-slate-500">Status</dt>
      <dd class="text-slate-900">{record.status}</dd>
    </div>
    <div class="flex justify-between gap-4 border-b border-slate-100 py-2">
      <dt class="text-slate-500">Submitted</dt>
      <dd class="text-right text-slate-900">
        <div class="font-medium">{formatRelativeTime(record.submitted_at, now)}</div>
        <div class="text-xs font-normal text-slate-500">{String(record.submitted_at ?? "").slice(0, 19).replace("T", " ")}</div>
      </dd>
    </div>
  </dl>

  <section class="mt-10 max-w-xl">
    <h2 class="text-lg font-semibold text-slate-900">Change status</h2>
    <form method="post" action="/recruiter/actions/application-status" class="mt-3 flex flex-wrap items-end gap-3">
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="application_id" value={record.id} />
      <label class="flex flex-col gap-1 text-sm">
        <span class="text-slate-600">New status</span>
        <select name="status" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900">
          {APPLICATION_STATUSES.map((s) => (
            <option value={s} selected={s === record.status}>
              {s}
            </option>
          ))}
        </select>
      </label>
      <button type="submit" class="btn-primary btn-sm">Save status</button>
    </form>
  </section>

  <p class="mt-8">
    <a
      class="btn-primary btn-sm"
      href={`/recruiter/applications/${record.id}/cv`}
      target="_blank"
      rel="noopener noreferrer"
    >
      Download CV
    </a>
  </p>

  <section class="mt-12 max-w-2xl">
    <h2 class="text-lg font-semibold text-slate-900">Notes</h2>
    <ul class="mt-3 space-y-3">
      {
        notes.length === 0 ? (
          <li class="text-sm text-slate-500">No notes yet.</li>
        ) : (
          notes.map((n) => (
            <li class="rounded-md border border-slate-200 bg-white px-3 py-2 text-sm">
              <p class="whitespace-pre-wrap text-slate-900">{n.body}</p>
              <p class="mt-1 text-xs text-slate-500">
                {formatRelativeTime(n.created, now)}
                {n.created ? <span class="text-slate-400"> · {String(n.created).slice(0, 19).replace("T", " ")}</span> : null}
              </p>
            </li>
          ))
        )
      }
    </ul>
    <form method="post" action="/recruiter/actions/application-note" class="mt-4 flex flex-col gap-2">
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="application_id" value={record.id} />
      <label class="text-sm text-slate-600">
        Add note
        <textarea
          name="body"
          rows={4}
          class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900"
          placeholder="Internal note…"
        />
      </label>
      <button type="submit" class="btn-primary btn-sm self-start">Add note</button>
    </form>
  </section>

  <section class="mt-12 max-w-2xl">
    <h2 class="text-lg font-semibold text-slate-900">Status history</h2>
    <ul class="mt-3 space-y-2 text-sm">
      {
        history.length === 0 ? (
          <li class="text-slate-500">No history yet.</li>
        ) : (
          history.map((h) => (
            <li class="border-b border-slate-100 py-2 text-slate-700">
              <span class="font-medium text-slate-900">{h.from_status || "—"}</span>
              <span class="text-slate-400"> → </span>
              <span class="font-medium text-slate-900">{h.to_status}</span>
              <span class="ml-2 text-xs text-slate-500">
                {formatRelativeTime(h.created, now)}
                {h.created ? <span class="text-slate-400"> · {String(h.created).slice(0, 19).replace("T", " ")}</span> : null}
              </span>
            </li>
          ))
        )
      }
    </ul>
  </section>
</RecruiterLayout>
