---
import RecruiterLayout from "../../../layouts/RecruiterLayout.astro";
import { APPLICATION_STATUSES } from "../../../lib/application-statuses";
import {
  cvFilename,
  formatConsent,
  formatSubmittedAt,
  NOT_PROVIDED,
  optionalApplicantText,
  optionalApplicantUrl,
  requiredApplicantText,
  trimStr,
} from "../../../lib/recruiter-application-display";
import { recruiterApplicationDetailErrors } from "../../../lib/recruiter-flash";
import { ensureSessionCsrfCookie } from "../../../lib/recruiter-auth/cookies";
import { externalLinkAnchorText } from "../../../lib/recruiter-external-link-label";
import { formatRelativeTime } from "../../../lib/relative-time";
import { getCompanyName } from "../../../lib/site";

export const prerender = false;

const id = Astro.params.id;
if (!id) {
  return Astro.redirect("/recruiter/applications");
}

const { pb } = Astro.locals.recruiter!;
const csrf = ensureSessionCsrfCookie(Astro.cookies);
const companyName = getCompanyName();
const now = new Date();

const flash = {
  updated: Astro.url.searchParams.get("updated") === "1",
  note: Astro.url.searchParams.get("note") === "1",
  error: Astro.url.searchParams.get("error"),
};

const errorMsg = flash.error ? recruiterApplicationDetailErrors[flash.error] : undefined;

let record;
try {
  record = await pb.collection("applications").getOne(id, { expand: "job" });
} catch {
  return Astro.redirect("/recruiter/applications");
}

/** PocketBase list API rejects `sort` on system fields like `created` (400); sort in memory instead. */
function compareByCreatedThenId(
  a: { id: string; created?: string },
  b: { id: string; created?: string },
): number {
  const ta = Date.parse(String(a.created ?? ""));
  const tb = Date.parse(String(b.created ?? ""));
  if (Number.isFinite(ta) && Number.isFinite(tb) && ta !== tb) {
    return ta - tb;
  }
  return a.id.localeCompare(b.id);
}

const [notesRaw, historyRaw] = await Promise.all([
  pb.collection("application_notes").getFullList({
    filter: pb.filter("application = {:aid}", { aid: id }),
    requestKey: `recruiter_app_detail_notes_${id}`,
  }),
  pb.collection("application_status_history").getFullList({
    filter: pb.filter("application = {:aid}", { aid: id }),
    requestKey: `recruiter_app_detail_history_${id}`,
  }),
]);

const notes = [...notesRaw].sort(compareByCreatedThenId);
const history = [...historyRaw].sort((a, b) => compareByCreatedThenId(b, a));

const job = record.expand?.job as { id?: string; title?: string; slug?: string } | undefined;
const jobId = String(record.job ?? job?.id ?? "");
const jobTitle = trimStr(job?.title) !== "" ? trimStr(job?.title) : jobId !== "" ? "Job listing" : "Application";
const jobHref = jobId !== "" ? `/recruiter/jobs/${jobId}` : undefined;

const githubUrl = optionalApplicantUrl(record.github_url);
const portfolioUrl = optionalApplicantUrl(record.portfolio_url);
const linkedinUrl = optionalApplicantUrl(record.linkedin_url);
---

<RecruiterLayout title={`${record.full_name} | ${companyName}`}>
  <div class="mb-6 border-b border-slate-200 pb-6">
    <p class="text-sm text-slate-600">
      <a class="text-teal-800 hover:text-teal-900" href="/recruiter/applications">← Applications</a>
      <span class="mx-2 text-slate-300">|</span>
      <a class="text-teal-800 hover:text-teal-900" href="/recruiter/jobs">Jobs</a>
    </p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900 md:text-3xl">
      {requiredApplicantText(record.full_name)}
    </h1>
    <p class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm text-slate-600">
      <span class="font-medium text-slate-700">Role:</span>
      {
        jobHref ? (
          <a class="text-teal-800 hover:text-teal-900" href={jobHref}>
            {jobTitle}
          </a>
        ) : (
          <span>{jobTitle}</span>
        )
      }
      <span class="hidden sm:inline text-slate-300" aria-hidden="true">·</span>
      <span class="flex flex-wrap items-baseline gap-x-2 gap-y-0">
        <span class="font-medium text-slate-700">Applied</span>
        <span>{formatRelativeTime(record.submitted_at, now)}</span>
        <span class="text-xs text-slate-500">({formatSubmittedAt(record.submitted_at)})</span>
      </span>
    </p>
  </div>

  {
    flash.updated && (
      <p class="mb-6 rounded-md border border-teal-200 bg-teal-50 px-3 py-2 text-sm text-teal-900">Status updated.</p>
    )
  }
  {
    flash.note && (
      <p class="mb-6 rounded-md border border-teal-200 bg-teal-50 px-3 py-2 text-sm text-teal-900">Note added.</p>
    )
  }
  {
    errorMsg && (
      <p class="mb-6 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900">{errorMsg}</p>
    )
  }

  <div class="flex flex-col-reverse gap-8 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(280px,22rem)] lg:items-start lg:gap-10">
    <!-- Read-only: candidate + automatic context -->
    <div class="min-w-0 space-y-6" role="region" aria-labelledby="application-panel-heading">
      <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <header class="border-b border-slate-100 bg-slate-50/80 px-5 py-4">
          <h2 id="application-panel-heading" class="text-base font-semibold text-slate-900">Application</h2>
          <p class="mt-1 text-xs leading-relaxed text-slate-600">
            Read-only: what the candidate entered on the careers site. Optional answers show &ldquo;{NOT_PROVIDED}&rdquo; when blank.
          </p>
        </header>

        <div class="px-5 py-4">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Candidate answers</h3>
          <dl class="mt-3 divide-y divide-slate-100 text-sm">
            <div class="flex flex-col gap-1 py-3 first:pt-0 sm:flex-row sm:justify-between sm:gap-6">
              <dt class="shrink-0 font-medium text-slate-600">Full name</dt>
              <dd class="min-w-0 break-words text-slate-900 sm:max-w-[65%] sm:text-right">{requiredApplicantText(record.full_name)}</dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between sm:gap-6">
              <dt class="shrink-0 font-medium text-slate-600">Email</dt>
              <dd class="min-w-0 break-all text-slate-900 sm:max-w-[65%] sm:text-right">
                <a class="text-teal-800 hover:text-teal-900" href={`mailto:${requiredApplicantText(record.email)}`}>
                  {requiredApplicantText(record.email)}
                </a>
              </dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between sm:gap-6">
              <dt class="shrink-0 font-medium text-slate-600">Phone</dt>
              <dd class="min-w-0 break-words text-slate-900 sm:max-w-[65%] sm:text-right">{optionalApplicantText(record.phone_number)}</dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between sm:gap-6">
              <dt class="shrink-0 font-medium text-slate-600">Location</dt>
              <dd class="min-w-0 break-words text-slate-900 sm:max-w-[65%] sm:text-right">{optionalApplicantText(record.location)}</dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between sm:gap-6">
              <dt class="shrink-0 font-medium text-slate-600">Timezone</dt>
              <dd class="min-w-0 break-words text-slate-900 sm:max-w-[65%] sm:text-right">{optionalApplicantText(record.timezone)}</dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between sm:gap-6">
              <dt class="shrink-0 font-medium text-slate-600">GitHub</dt>
              <dd class="min-w-0 sm:max-w-[65%] sm:text-right">
                {
                  githubUrl ? (
                    <a
                      class="font-medium text-teal-800 hover:text-teal-900"
                      href={githubUrl}
                      rel="noopener noreferrer"
                      target="_blank"
                      title={githubUrl}
                    >
                      {externalLinkAnchorText(githubUrl)}
                    </a>
                  ) : (
                    <span class="text-slate-500">{NOT_PROVIDED}</span>
                  )
                }
              </dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between sm:gap-6">
              <dt class="shrink-0 font-medium text-slate-600">Portfolio</dt>
              <dd class="min-w-0 sm:max-w-[65%] sm:text-right">
                {
                  portfolioUrl ? (
                    <a
                      class="font-medium text-teal-800 hover:text-teal-900"
                      href={portfolioUrl}
                      rel="noopener noreferrer"
                      target="_blank"
                      title={portfolioUrl}
                    >
                      {externalLinkAnchorText(portfolioUrl)}
                    </a>
                  ) : (
                    <span class="text-slate-500">{NOT_PROVIDED}</span>
                  )
                }
              </dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between sm:gap-6">
              <dt class="shrink-0 font-medium text-slate-600">LinkedIn</dt>
              <dd class="min-w-0 sm:max-w-[65%] sm:text-right">
                {
                  linkedinUrl ? (
                    <a
                      class="font-medium text-teal-800 hover:text-teal-900"
                      href={linkedinUrl}
                      rel="noopener noreferrer"
                      target="_blank"
                      title={linkedinUrl}
                    >
                      {externalLinkAnchorText(linkedinUrl)}
                    </a>
                  ) : (
                    <span class="text-slate-500">{NOT_PROVIDED}</span>
                  )
                }
              </dd>
            </div>
            <div class="flex flex-col gap-1 py-3">
              <dt class="font-medium text-slate-600">Anything else</dt>
              <dd class="mt-1 whitespace-pre-wrap break-words text-slate-900">{optionalApplicantText(record.anything_else)}</dd>
            </div>
            <div class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
              <div>
                <dt class="font-medium text-slate-600">CV / resume</dt>
                <dd class="mt-1 font-mono text-xs text-slate-700">{cvFilename(record.cv_file)}</dd>
              </div>
              <div class="shrink-0 sm:pl-4">
                <a
                  class="btn-secondary btn-sm"
                  href={`/recruiter/applications/${record.id}/cv`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Open file
                </a>
              </div>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between sm:gap-6">
              <dt class="shrink-0 font-medium text-slate-600">Consent to store data</dt>
              <dd class="text-slate-900 sm:text-right">{formatConsent(record.consent_to_store_data)}</dd>
            </div>
          </dl>
        </div>

        <div class="border-t border-slate-100 bg-slate-50/60 px-5 py-4">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Submission context</h3>
          <p class="mt-1 text-xs text-slate-500">
            Captured automatically (not on the public form). IP location is approximate when lookup succeeds.
          </p>
          <dl class="mt-3 divide-y divide-slate-200/80 text-sm">
            <div class="flex flex-col gap-1 py-3 first:pt-0 sm:flex-row sm:justify-between sm:gap-6">
              <dt class="shrink-0 font-medium text-slate-600">Source</dt>
              <dd class="min-w-0 break-words text-slate-900 sm:max-w-[70%] sm:text-right">{optionalApplicantText(record.source)}</dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between sm:gap-6">
              <dt class="shrink-0 font-medium text-slate-600">Submission IP</dt>
              <dd class="min-w-0 break-all font-mono text-xs text-slate-800 sm:max-w-[70%] sm:text-right">
                {optionalApplicantText(record.submission_ip)}
              </dd>
            </div>
            <div class="flex flex-col gap-1 py-3">
              <dt class="font-medium text-slate-600">
                Approximate location <span class="font-normal text-slate-500">(from IP)</span>
              </dt>
              <dd class="mt-1 text-slate-900">{optionalApplicantText(record.submission_ip_location)}</dd>
            </div>
            <div class="flex flex-col gap-1 py-3">
              <dt class="font-medium text-slate-600">Browser (user agent)</dt>
              <dd class="mt-1 break-all font-mono text-xs text-slate-700">{optionalApplicantText(record.user_agent)}</dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between sm:gap-6">
              <dt class="shrink-0 font-medium text-slate-600">Duplicate submission key</dt>
              <dd class="min-w-0 break-all font-mono text-xs text-slate-700 sm:max-w-[70%] sm:text-right">
                {optionalApplicantText(record.duplicate_key)}
              </dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between sm:gap-6">
              <dt class="shrink-0 font-medium text-slate-600">Record ID</dt>
              <dd class="min-w-0 break-all font-mono text-xs text-slate-700 sm:max-w-[70%] sm:text-right">{record.id}</dd>
            </div>
          </dl>
        </div>
      </section>
    </div>

    <!-- Recruiter workflow -->
    <aside class="min-w-0 space-y-6 lg:sticky lg:top-6" aria-labelledby="review-panel-heading">
      <section class="overflow-hidden rounded-xl border border-teal-200/70 bg-gradient-to-b from-teal-50/90 to-white shadow-sm ring-1 ring-teal-100/80">
        <header class="border-b border-teal-100/90 px-5 py-4">
          <h2 id="review-panel-heading" class="text-base font-semibold text-slate-900">Review</h2>
          <p class="mt-1 text-xs leading-relaxed text-slate-600">
            Set pipeline status, download the CV, then add internal notes below.
          </p>
        </header>
        <div class="space-y-5 px-5 py-5">
          <form method="post" action="/recruiter/actions/application-status" class="space-y-3">
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="application_id" value={record.id} />
            <label class="block text-sm font-medium text-slate-700">
              Pipeline status
              <select
                name="status"
                class="mt-1.5 w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-sm font-medium text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
              >
                {APPLICATION_STATUSES.map((s) => (
                  <option value={s} selected={s === record.status}>
                    {s}
                  </option>
                ))}
              </select>
            </label>
            <button type="submit" class="btn-primary w-full justify-center py-2.5 text-sm font-semibold">
              Save status
            </button>
          </form>
          <div class="border-t border-teal-100/80 pt-5">
            <a
              class="btn-primary flex w-full items-center justify-center gap-2 py-2.5 text-sm font-semibold shadow-md"
              href={`/recruiter/applications/${record.id}/cv`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Download CV
            </a>
            <p class="mt-2 text-center font-mono text-[11px] text-slate-500">{cvFilename(record.cv_file)}</p>
          </div>
        </div>
      </section>

      <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <header class="border-b border-slate-100 px-5 py-3">
          <h2 class="text-sm font-semibold text-slate-900">Internal notes</h2>
          <p class="mt-0.5 text-xs text-slate-500">Visible only to portal users.</p>
        </header>
        <div class="px-5 py-4">
          <ul class="max-h-56 space-y-3 overflow-y-auto pr-1 text-sm">
            {
              notes.length === 0 ? (
                <li class="text-slate-500">No notes yet.</li>
              ) : (
                notes.map((n) => (
                  <li class="rounded-lg border border-slate-100 bg-slate-50/80 px-3 py-2">
                    <p class="whitespace-pre-wrap text-slate-900">{n.body}</p>
                    <p class="mt-1 text-xs text-slate-500">
                      {formatRelativeTime(n.created, now)}
                      {n.created ? <span class="text-slate-400"> · {String(n.created).slice(0, 19).replace("T", " ")}</span> : null}
                    </p>
                  </li>
                ))
              )
            }
          </ul>
          <form method="post" action="/recruiter/actions/application-note" class="mt-4 space-y-2 border-t border-slate-100 pt-4">
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="application_id" value={record.id} />
            <label class="block text-xs font-medium text-slate-600">
              Add note
              <textarea
                name="body"
                rows={3}
                class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
                placeholder="Internal note…"
              />
            </label>
            <button type="submit" class="btn-secondary btn-sm w-full justify-center">Add note</button>
          </form>
        </div>
      </section>

      <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <header class="border-b border-slate-100 px-5 py-3">
          <h2 class="text-sm font-semibold text-slate-900">Status history</h2>
        </header>
        <ul class="max-h-64 space-y-0 overflow-y-auto px-5 py-3 text-sm">
          {
            history.length === 0 ? (
              <li class="py-2 text-slate-500">No history yet.</li>
            ) : (
              history.map((h) => (
                <li class="border-b border-slate-100 py-2.5 text-slate-700 last:border-0">
                  <span class="font-medium text-slate-900">{h.from_status || "—"}</span>
                  <span class="text-slate-400"> → </span>
                  <span class="font-medium text-slate-900">{h.to_status}</span>
                  <span class="mt-0.5 block text-xs text-slate-500">
                    {formatRelativeTime(h.created, now)}
                    {h.created ? <span class="text-slate-400"> · {String(h.created).slice(0, 19).replace("T", " ")}</span> : null}
                  </span>
                </li>
              ))
            )
          }
        </ul>
      </section>
    </aside>
  </div>
</RecruiterLayout>
