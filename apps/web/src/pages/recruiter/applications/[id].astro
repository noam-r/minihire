---
import RecruiterLayout from "../../../layouts/RecruiterLayout.astro";
import { APPLICATION_STATUSES } from "../../../lib/application-statuses";
import {
  cvFilename,
  formatConsent,
  formatSubmittedAt,
  NOT_PROVIDED,
  optionalApplicantText,
  optionalApplicantUrl,
  requiredApplicantText,
  trimStr,
} from "../../../lib/recruiter-application-display";
import { recruiterApplicationDetailErrors } from "../../../lib/recruiter-flash";
import { ensureSessionCsrfCookie } from "../../../lib/recruiter-auth/cookies";
import { formatRelativeTime } from "../../../lib/relative-time";
import { getCompanyName } from "../../../lib/site";

export const prerender = false;

const id = Astro.params.id;
if (!id) {
  return Astro.redirect("/recruiter/applications");
}

const { pb } = Astro.locals.recruiter!;
const csrf = ensureSessionCsrfCookie(Astro.cookies);
const companyName = getCompanyName();
const now = new Date();

const flash = {
  updated: Astro.url.searchParams.get("updated") === "1",
  note: Astro.url.searchParams.get("note") === "1",
  error: Astro.url.searchParams.get("error"),
};

const errorMsg = flash.error ? recruiterApplicationDetailErrors[flash.error] : undefined;

let record;
try {
  record = await pb.collection("applications").getOne(id, { expand: "job" });
} catch {
  return Astro.redirect("/recruiter/applications");
}

/** PocketBase list API rejects `sort` on system fields like `created` (400); sort in memory instead. */
function compareByCreatedThenId(
  a: { id: string; created?: string },
  b: { id: string; created?: string },
): number {
  const ta = Date.parse(String(a.created ?? ""));
  const tb = Date.parse(String(b.created ?? ""));
  if (Number.isFinite(ta) && Number.isFinite(tb) && ta !== tb) {
    return ta - tb;
  }
  return a.id.localeCompare(b.id);
}

const [notesRaw, historyRaw] = await Promise.all([
  pb.collection("application_notes").getFullList({
    filter: pb.filter("application = {:aid}", { aid: id }),
    requestKey: `recruiter_app_detail_notes_${id}`,
  }),
  pb.collection("application_status_history").getFullList({
    filter: pb.filter("application = {:aid}", { aid: id }),
    requestKey: `recruiter_app_detail_history_${id}`,
  }),
]);

const notes = [...notesRaw].sort(compareByCreatedThenId);
const history = [...historyRaw].sort((a, b) => compareByCreatedThenId(b, a));

const job = record.expand?.job as { id?: string; title?: string; slug?: string } | undefined;
const jobId = String(record.job ?? job?.id ?? "");
const jobTitle = trimStr(job?.title) !== "" ? trimStr(job?.title) : jobId !== "" ? "Job listing" : "Application";
const jobHref = jobId !== "" ? `/recruiter/jobs/${jobId}` : undefined;

const githubUrl = optionalApplicantUrl(record.github_url);
const portfolioUrl = optionalApplicantUrl(record.portfolio_url);
const linkedinUrl = optionalApplicantUrl(record.linkedin_url);
---

<RecruiterLayout title={`${record.full_name} | ${companyName}`}>
  <p class="text-sm text-slate-600">
    <a class="text-teal-800 hover:text-teal-900" href="/recruiter/applications">← Applications</a>
    <span class="mx-2 text-slate-300">|</span>
    <a class="text-teal-800 hover:text-teal-900" href="/recruiter/jobs">Jobs</a>
  </p>
  <h1 class="mt-2 text-2xl font-semibold text-slate-900">{requiredApplicantText(record.full_name)}</h1>
  <p class="text-sm text-slate-600">
    {
      jobHref ? (
        <a class="text-teal-800 hover:text-teal-900" href={jobHref}>
          {jobTitle}
        </a>
      ) : (
        jobTitle
      )
    }
  </p>

  {
    flash.updated && (
      <p class="mt-4 rounded-md border border-teal-200 bg-teal-50 px-3 py-2 text-sm text-teal-900">Status updated.</p>
    )
  }
  {
    flash.note && (
      <p class="mt-4 rounded-md border border-teal-200 bg-teal-50 px-3 py-2 text-sm text-teal-900">Note added.</p>
    )
  }
  {
    errorMsg && (
      <p class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900">{errorMsg}</p>
    )
  }

  <section class="mt-8 max-w-2xl">
    <h2 class="text-lg font-semibold text-slate-900">Candidate responses</h2>
    <p class="mt-1 text-xs text-slate-500">
      Every field from the application form is listed. Optional fields show &ldquo;{NOT_PROVIDED}&rdquo; when the candidate left them blank.
    </p>
    <dl class="mt-4 divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white text-sm">
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">Full name</dt>
        <dd class="min-w-0 break-words text-right text-slate-900 sm:text-right">{requiredApplicantText(record.full_name)}</dd>
      </div>
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">Email</dt>
        <dd class="min-w-0 break-all text-right text-slate-900 sm:text-right">
          <a class="text-teal-800 hover:text-teal-900" href={`mailto:${requiredApplicantText(record.email)}`}>
            {requiredApplicantText(record.email)}
          </a>
        </dd>
      </div>
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">Phone</dt>
        <dd class="min-w-0 break-words text-right text-slate-900 sm:text-right">{optionalApplicantText(record.phone_number)}</dd>
      </div>
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">Location</dt>
        <dd class="min-w-0 break-words text-right text-slate-900 sm:text-right">{optionalApplicantText(record.location)}</dd>
      </div>
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">Timezone</dt>
        <dd class="min-w-0 break-words text-right text-slate-900 sm:text-right">{optionalApplicantText(record.timezone)}</dd>
      </div>
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">GitHub</dt>
        <dd class="min-w-0 text-right sm:text-right">
          {
            githubUrl ? (
              <a class="break-all text-teal-800 hover:text-teal-900" href={githubUrl} rel="noopener noreferrer" target="_blank">
                {githubUrl}
              </a>
            ) : (
              <span class="text-slate-500">{NOT_PROVIDED}</span>
            )
          }
        </dd>
      </div>
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">Portfolio</dt>
        <dd class="min-w-0 text-right sm:text-right">
          {
            portfolioUrl ? (
              <a class="break-all text-teal-800 hover:text-teal-900" href={portfolioUrl} rel="noopener noreferrer" target="_blank">
                {portfolioUrl}
              </a>
            ) : (
              <span class="text-slate-500">{NOT_PROVIDED}</span>
            )
          }
        </dd>
      </div>
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">LinkedIn</dt>
        <dd class="min-w-0 text-right sm:text-right">
          {
            linkedinUrl ? (
              <a class="break-all text-teal-800 hover:text-teal-900" href={linkedinUrl} rel="noopener noreferrer" target="_blank">
                {linkedinUrl}
              </a>
            ) : (
              <span class="text-slate-500">{NOT_PROVIDED}</span>
            )
          }
        </dd>
      </div>
      <div class="flex flex-col gap-1 px-4 py-3">
        <dt class="font-medium text-slate-600">Anything else</dt>
        <dd class="mt-1 whitespace-pre-wrap break-words text-slate-900">{optionalApplicantText(record.anything_else)}</dd>
      </div>
      <div class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
        <div>
          <dt class="font-medium text-slate-600">CV / resume</dt>
          <dd class="mt-1 font-mono text-xs text-slate-700">{cvFilename(record.cv_file)}</dd>
        </div>
        <div class="shrink-0">
          <a
            class="btn-primary btn-sm"
            href={`/recruiter/applications/${record.id}/cv`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Download CV
          </a>
        </div>
      </div>
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">Consent to store data</dt>
        <dd class="text-right text-slate-900 sm:text-right">{formatConsent(record.consent_to_store_data)}</dd>
      </div>
    </dl>
  </section>

  <section class="mt-10 max-w-2xl">
    <h2 class="text-lg font-semibold text-slate-900">Pipeline</h2>
    <dl class="mt-3 divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white text-sm">
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">Status</dt>
        <dd class="text-right font-medium text-slate-900 sm:text-right">{requiredApplicantText(record.status)}</dd>
      </div>
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">Submitted</dt>
        <dd class="text-right text-slate-900 sm:text-right">
          <div class="font-medium">{formatRelativeTime(record.submitted_at, now)}</div>
          <div class="text-xs font-normal text-slate-500">{formatSubmittedAt(record.submitted_at)}</div>
        </dd>
      </div>
    </dl>
  </section>

  <section class="mt-10 max-w-2xl">
    <h2 class="text-lg font-semibold text-slate-900">Submission metadata</h2>
    <p class="mt-1 text-xs text-slate-500">Captured automatically with the application (not shown on the public form).</p>
    <dl class="mt-3 divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white text-sm">
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">Source</dt>
        <dd class="min-w-0 break-words text-right text-slate-900 sm:text-right">{optionalApplicantText(record.source)}</dd>
      </div>
      <div class="flex flex-col gap-1 px-4 py-3">
        <dt class="font-medium text-slate-600">Browser (user agent)</dt>
        <dd class="mt-1 break-all font-mono text-xs text-slate-700">{optionalApplicantText(record.user_agent)}</dd>
      </div>
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">Duplicate submission key</dt>
        <dd class="min-w-0 break-all text-right font-mono text-xs text-slate-700 sm:text-right">
          {optionalApplicantText(record.duplicate_key)}
        </dd>
      </div>
      <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:justify-between sm:gap-6">
        <dt class="shrink-0 font-medium text-slate-600">Record ID</dt>
        <dd class="min-w-0 break-all text-right font-mono text-xs text-slate-700 sm:text-right">{record.id}</dd>
      </div>
    </dl>
  </section>

  <section class="mt-10 max-w-xl">
    <h2 class="text-lg font-semibold text-slate-900">Change status</h2>
    <form method="post" action="/recruiter/actions/application-status" class="mt-3 flex flex-wrap items-end gap-3">
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="application_id" value={record.id} />
      <label class="flex flex-col gap-1 text-sm">
        <span class="text-slate-600">New status</span>
        <select name="status" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900">
          {APPLICATION_STATUSES.map((s) => (
            <option value={s} selected={s === record.status}>
              {s}
            </option>
          ))}
        </select>
      </label>
      <button type="submit" class="btn-primary btn-sm">Save status</button>
    </form>
  </section>

  <section class="mt-12 max-w-2xl">
    <h2 class="text-lg font-semibold text-slate-900">Notes</h2>
    <ul class="mt-3 space-y-3">
      {
        notes.length === 0 ? (
          <li class="text-sm text-slate-500">No notes yet.</li>
        ) : (
          notes.map((n) => (
            <li class="rounded-md border border-slate-200 bg-white px-3 py-2 text-sm">
              <p class="whitespace-pre-wrap text-slate-900">{n.body}</p>
              <p class="mt-1 text-xs text-slate-500">
                {formatRelativeTime(n.created, now)}
                {n.created ? <span class="text-slate-400"> · {String(n.created).slice(0, 19).replace("T", " ")}</span> : null}
              </p>
            </li>
          ))
        )
      }
    </ul>
    <form method="post" action="/recruiter/actions/application-note" class="mt-4 flex flex-col gap-2">
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="application_id" value={record.id} />
      <label class="text-sm text-slate-600">
        Add note
        <textarea
          name="body"
          rows={4}
          class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900"
          placeholder="Internal note…"
        />
      </label>
      <button type="submit" class="btn-primary btn-sm self-start">Add note</button>
    </form>
  </section>

  <section class="mt-12 max-w-2xl">
    <h2 class="text-lg font-semibold text-slate-900">Status history</h2>
    <ul class="mt-3 space-y-2 text-sm">
      {
        history.length === 0 ? (
          <li class="text-slate-500">No history yet.</li>
        ) : (
          history.map((h) => (
            <li class="border-b border-slate-100 py-2 text-slate-700">
              <span class="font-medium text-slate-900">{h.from_status || "—"}</span>
              <span class="text-slate-400"> → </span>
              <span class="font-medium text-slate-900">{h.to_status}</span>
              <span class="ml-2 text-xs text-slate-500">
                {formatRelativeTime(h.created, now)}
                {h.created ? <span class="text-slate-400"> · {String(h.created).slice(0, 19).replace("T", " ")}</span> : null}
              </span>
            </li>
          ))
        )
      }
    </ul>
  </section>
</RecruiterLayout>
