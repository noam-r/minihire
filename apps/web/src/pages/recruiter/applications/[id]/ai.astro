---
import MarkdownContent from "../../../../components/MarkdownContent.astro";
import AiCriticalAlerts from "../../../../components/recruiter/AiCriticalAlerts.astro";
import AiEvaluationDrillDown from "../../../../components/recruiter/AiEvaluationDrillDown.astro";
import AiEvaluationSummary from "../../../../components/recruiter/AiEvaluationSummary.astro";
import ScoreBar from "../../../../components/recruiter/ScoreBar.astro";
import RecruiterLayout from "../../../../layouts/RecruiterLayout.astro";
import type { JobRecord } from "../../../../lib/ai/pocketbase";
import {
  AI_DISCLAIMER,
  stripEmbeddedReportDisclaimer,
  AI_EVIDENCE_DISCLAIMER,
  evidencePreview,
  formatConfidence,
  formatJudgement,
  formatRequirementType,
  requirementTypeEvaluated,
  friendlyAiFailure,
} from "../../../../lib/recruiter-ai/display";
import {
  buildEvidenceRationaleView,
  contactFromApplication,
  jobContextFromRecord,
} from "../../../../lib/recruiter-ai/build-evidence-rationale-view";
import { loadRecruiterAiSnapshot } from "../../../../lib/recruiter-ai/load-snapshot";
import { ensureSessionCsrfCookie } from "../../../../lib/recruiter-auth/cookies";
import { getCompanyName } from "../../../../lib/site";

export const prerender = false;

const id = Astro.params.id;
if (!id) {
  return Astro.redirect("/recruiter/applications");
}

const { pb, user } = Astro.locals.recruiter!;
const csrf = ensureSessionCsrfCookie(Astro.cookies);
const companyName = getCompanyName();

let record;
try {
  record = await pb.collection("applications").getOne(id, { expand: "job" });
} catch {
  return Astro.redirect("/recruiter/applications");
}

const snapshot = await loadRecruiterAiSnapshot(pb, id);
const report = snapshot.latestReport;
const validation = snapshot.latestValidation;
const normalization = snapshot.latestNormalization;
const autoRefresh = snapshot.state === "in_progress";

const requiredEvaluated = requirementTypeEvaluated(snapshot.requirementMatches, "required");
const niceEvaluated = requirementTypeEvaluated(snapshot.requirementMatches, "nice_to_have");
const overallFit = report?.overall_fit_score ?? report?.cv_fit_score ?? validation?.cv_fit_score;
const cvFit = report?.cv_fit_score ?? validation?.cv_fit_score;
const requiredScore = report?.required_skills_score ?? validation?.required_skills_score;
const niceScore = report?.nice_to_have_score ?? validation?.nice_to_have_score;

const expandedJob = record.expand?.job as JobRecord | undefined;
const jobId = typeof record.job === "string" ? record.job : (expandedJob?.id ?? "");
const jobContext = expandedJob ? jobContextFromRecord(expandedJob) : undefined;
const applicationContact = contactFromApplication({
  location: String(record.location ?? ""),
  timezone: String(record.timezone ?? ""),
  phone_number: String(record.phone_number ?? ""),
});

const rationaleView =
  snapshot.state === "complete"
    ? buildEvidenceRationaleView({
        snapshot,
        report,
        validation,
        normalization,
        applicationId: id,
        jobId,
        job: jobContext,
        contact: applicationContact,
      })
    : null;

const requirementCount = snapshot.requirementMatches.length;
const questionCount = snapshot.suggestedQuestions.length;
---

<RecruiterLayout title={`AI evidence | ${record.full_name} | ${companyName}`}>
  {autoRefresh && <meta slot="head" http-equiv="refresh" content="12" />}

  <div class="mb-6 border-b border-slate-200 pb-6">
    <p class="text-sm text-slate-600">
      <a class="text-teal-800 hover:text-teal-900" href={`/recruiter/applications/${id}`}>
        ← Back to application
      </a>
    </p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">AI evaluation evidence</h1>
    <p class="mt-2 text-sm text-slate-600">{record.full_name}</p>
    <p class="mt-3 text-xs leading-relaxed text-slate-600">{AI_DISCLAIMER}</p>
  </div>

  {
    snapshot.state === "not_run" && (
      <p class="rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-600">
        No AI evaluation has been run for this application yet.
      </p>
    )
  }

  {
    snapshot.state === "in_progress" && (
      <p class="rounded-xl border border-amber-200 bg-amber-50 p-6 text-sm text-amber-950">
        AI evaluation is in progress. Return to the application page or reload in a few moments.
      </p>
    )
  }

  {
    (snapshot.state === "failed" || snapshot.state === "skipped") && (
      <section class="space-y-4 rounded-xl border border-red-200 bg-red-50/50 p-6">
        <h2 class="text-lg font-semibold text-red-900">
          {snapshot.state === "skipped" ? "Validation skipped" : "Evaluation failed"}
        </h2>
        <p class="text-sm text-red-950">
          {friendlyAiFailure({
            runError: snapshot.latestRun?.error_message,
            validationError: validation?.error_message,
            normalizationError: normalization?.error_message,
            extractionStatus: normalization?.cv_extraction_status,
          })}
        </p>
        <form method="post" action="/recruiter/actions/run-ai-evaluation">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="application_id" value={id} />
          <button type="submit" class="btn-secondary btn-sm">Re-run AI evaluation</button>
        </form>
      </section>
    )
  }

  {
    snapshot.state === "complete" && (
      <div class="space-y-8">
        <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-semibold text-slate-900">At a glance</h2>
          <p class="mt-1 text-xs text-slate-500">Scores use a 0–5 scale (5 = strongest match).</p>

          {rationaleView && rationaleView.criticalFindings.length > 0 && (
            <div class="mt-4">
              <AiCriticalAlerts findings={rationaleView.criticalFindings} />
            </div>
          )}

          {
            rationaleView?.candidateSummary && (
              <div class="mt-4">
                <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Candidate summary</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-700">{rationaleView.candidateSummary}</p>
              </div>
            )
          }

          <dl class="mt-5 grid gap-5 sm:grid-cols-2">
            <ScoreBar label="Overall fit" value={overallFit} evaluated={overallFit != null} />
            <ScoreBar label="CV fit" value={cvFit} evaluated={cvFit != null} />
            <ScoreBar
              label="Required skills"
              value={requiredScore}
              evaluated={requiredEvaluated}
              detail={requiredEvaluated ? "Based on required items assessed in the CV" : undefined}
            />
            <ScoreBar
              label="Nice-to-have"
              value={niceScore}
              evaluated={niceEvaluated}
              detail={niceEvaluated ? "Based on nice-to-have items assessed in the CV" : undefined}
            />
          </dl>

          {rationaleView && <AiEvaluationSummary rationale={rationaleView} />}
          {rationaleView && <AiEvaluationDrillDown rationale={rationaleView} />}
        </section>

        {requirementCount > 0 && (
          <details class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <summary class="cursor-pointer border-b border-slate-100 px-6 py-4 text-lg font-semibold text-slate-900">
              Requirement-level evidence ({requirementCount} items)
            </summary>
            <p class="border-b border-slate-100 px-6 pb-3 text-xs leading-relaxed text-slate-500">
              {AI_EVIDENCE_DISCLAIMER}
            </p>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[56rem] text-left text-sm">
                <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    <th class="px-4 py-3 font-medium">Requirement</th>
                    <th class="px-4 py-3 font-medium">Type</th>
                    <th class="px-4 py-3 font-medium">CV assessment</th>
                    <th class="px-4 py-3 font-medium">Confidence</th>
                    <th class="px-4 py-3 font-medium">Reasoning</th>
                    <th class="px-4 py-3 font-medium">Evidence</th>
                  </tr>
                </thead>
                <tbody>
                  {snapshot.requirementMatches.map((m) => (
                    <tr class="border-t border-slate-100">
                      <td class="px-4 py-3 text-slate-900">{m.requirement}</td>
                      <td class="px-4 py-3 text-slate-600">{formatRequirementType(m.requirementType)}</td>
                      <td class="px-4 py-3 text-slate-600">{formatJudgement(m.judgement)}</td>
                      <td class="px-4 py-3 text-slate-600">{formatConfidence(m.confidence)}</td>
                      <td class="max-w-sm px-4 py-3 text-slate-700">{m.reasoning?.trim() || "—"}</td>
                      <td class="max-w-xs px-4 py-3 text-slate-700">{evidencePreview(m)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        )}

        {questionCount > 0 && (
          <details class="rounded-xl border border-slate-200 bg-white shadow-sm">
            <summary class="cursor-pointer px-6 py-4 text-lg font-semibold text-slate-900">
              Suggested clarification questions ({questionCount})
            </summary>
            <ul class="list-disc space-y-2 border-t border-slate-100 px-6 py-4 pl-10 text-slate-700">
              {snapshot.suggestedQuestions.map((q) => (
                <li>{q}</li>
              ))}
            </ul>
          </details>
        )}

        {report?.report_md && (
          <details class="rounded-xl border border-slate-200 bg-white shadow-sm">
            <summary class="cursor-pointer px-6 py-4 text-lg font-semibold text-slate-900">
              Full evaluation report
            </summary>
            <div class="border-t border-slate-100 px-6 py-4">
              <p class="mb-4 text-xs text-slate-500">
                Same narrative as export—expand to verify details not shown above.
              </p>
              <div class="flex flex-wrap gap-2 pb-4">
                <a
                  class="btn-secondary btn-sm"
                  href={`/recruiter/applications/${id}/ai-report-export?format=markdown`}
                  download
                >
                  Export Markdown
                </a>
                <a class="btn-secondary btn-sm" href={`/recruiter/applications/${id}/ai-report-export?format=pdf`}>
                  Export PDF
                </a>
              </div>
              <MarkdownContent
                content={stripEmbeddedReportDisclaimer(report.report_md)}
                class="prose-ai-report"
              />
            </div>
          </details>
        )}

        {user.role === "admin" && validation && (
          <section class="rounded-xl border border-slate-200 bg-slate-50 p-6 text-xs text-slate-600">
            <h2 class="font-semibold text-slate-800">Technical details</h2>
            <ul class="mt-2 space-y-1 font-mono">
              {snapshot.latestRun && <li>run: {snapshot.latestRun.id}</li>}
              {validation.model && <li>model: {validation.model}</li>}
              {validation.prompt_version && <li>prompt: {validation.prompt_version}</li>}
              {validation.response_schema_version && <li>schema: {validation.response_schema_version}</li>}
              {validation.scoring_version && <li>scoring: {validation.scoring_version}</li>}
            </ul>
          </section>
        )}

        <form method="post" action="/recruiter/actions/run-ai-evaluation" class="pb-8">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="application_id" value={id} />
          <button type="submit" class="btn-secondary">Re-run AI evaluation</button>
        </form>
      </div>
    )
  }
</RecruiterLayout>
