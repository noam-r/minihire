---
import RecruiterLayout from "../../../../layouts/RecruiterLayout.astro";
import {
  defaultCandidateEmailBody,
  defaultCandidateEmailSubject,
} from "../../../../lib/recruiter-candidate-email/templates";
import {
  isRecruiterCandidateEmailType,
  RECRUITER_CANDIDATE_EMAIL_TYPES,
  type RecruiterCandidateEmailType,
} from "../../../../lib/recruiter-candidate-email/types";
import { MAX_CANDIDATE_EMAIL_BODY_LEN } from "../../../../lib/recruiter-candidate-email/validation";
import { ensureSessionCsrfCookie } from "../../../../lib/recruiter-auth/cookies";
import { getCompanyName } from "../../../../lib/site";

export const prerender = false;

const id = Astro.params.id;
if (!id) {
  return Astro.redirect("/recruiter/applications");
}

const { pb } = Astro.locals.recruiter!;
const csrf = ensureSessionCsrfCookie(Astro.cookies);
const companyName = getCompanyName();

const errorCode = Astro.url.searchParams.get("error");
const errorMsg =
  errorCode === "invalid" ? "Check the email body and try again." : undefined;

let record;
try {
  record = await pb.collection("applications").getOne(id, { expand: "job" });
} catch {
  return Astro.redirect("/recruiter/applications");
}

const typeParam = Astro.url.searchParams.get("type") ?? "rejection";
const emailType: RecruiterCandidateEmailType = isRecruiterCandidateEmailType(typeParam)
  ? typeParam
  : "rejection";

const job = record.expand?.job as { title?: string } | undefined;
const jobTitle = String(job?.title ?? "").trim() || "your application";
const candidateName = String(record.full_name ?? "").trim();
const candidateEmail = String(record.email ?? "").trim();

const templateInput = { candidateName, jobTitle };
const subjectPreview = defaultCandidateEmailSubject(emailType, templateInput);
const defaultBody = defaultCandidateEmailBody(emailType, templateInput);

const typeLabels: Record<RecruiterCandidateEmailType, string> = {
  rejection: "Rejection",
  free_text_clarification: "Free-text clarification",
};
---

<RecruiterLayout title={`Send email | ${companyName}`}>
  <p class="text-sm text-slate-600">
    <a class="text-teal-800 hover:text-teal-900" href={`/recruiter/applications/${id}`}>← Application</a>
  </p>

  <h1 class="mt-4 text-2xl font-semibold text-slate-900">Send email to candidate</h1>
  <p class="mt-2 text-sm text-slate-600">
    Compose a message to {candidateName || "the candidate"}. The greeting and sign-off are added automatically.
  </p>

  {errorMsg && (
    <p class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900">{errorMsg}</p>
  )}

  <div class="mt-4 flex flex-wrap gap-2 text-sm">
    {
      RECRUITER_CANDIDATE_EMAIL_TYPES.map((type) => (
        <a
          class:list={[
            "rounded-full border px-3 py-1 no-underline",
            type === emailType
              ? "border-teal-600 bg-teal-50 font-medium text-teal-900"
              : "border-slate-200 bg-white text-slate-700 hover:border-slate-300",
          ]}
          href={`/recruiter/applications/${id}/email?type=${type}`}
        >
          {typeLabels[type]}
        </a>
      ))
    }
  </div>

  <form
    method="post"
    action="/recruiter/actions/send-candidate-email"
    class="mt-6 max-w-2xl space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"
  >
    <input type="hidden" name="csrf" value={csrf} />
    <input type="hidden" name="application_id" value={record.id} />
    <input type="hidden" name="email_type" value={emailType} />

    <div class="space-y-1 text-sm">
      <p class="font-medium text-slate-700">To</p>
      <p class="text-slate-600">{candidateEmail || "—"}</p>
    </div>

    <div class="space-y-1 text-sm">
      <p class="font-medium text-slate-700">Subject</p>
      <p class="text-slate-600">{subjectPreview}</p>
    </div>

    <label class="block text-sm font-medium text-slate-700">
      Message
      <textarea
        name="body"
        rows={12}
        maxlength={MAX_CANDIDATE_EMAIL_BODY_LEN}
        required
        class="mt-1.5 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
      >{defaultBody}</textarea>
      <p class="mt-1 text-xs text-slate-500">Up to {MAX_CANDIDATE_EMAIL_BODY_LEN} characters.</p>
    </label>

    {
      emailType === "rejection" && (
        <label class="flex items-start gap-2 text-sm text-slate-700">
          <input
            type="checkbox"
            name="set_rejected"
            value="1"
            class="mt-1 rounded border-slate-300 text-teal-700 focus:ring-teal-600"
          />
          <span>Set application status to rejected</span>
        </label>
      )
    }

    <div class="flex flex-wrap gap-2 border-t border-slate-100 pt-4">
      <button type="submit" class="btn-primary btn-sm">Send email</button>
      <a class="btn-secondary btn-sm no-underline" href={`/recruiter/applications/${id}`}>Cancel</a>
    </div>
  </form>
</RecruiterLayout>
