---
import ApplicationInboxRow from "../../../components/recruiter/ApplicationInboxRow.astro";
import {
  applicationInboxHeaderCellClass,
  applicationInboxTableClass,
} from "../../../lib/application-inbox-layout";
import RecruiterLayout from "../../../layouts/RecruiterLayout.astro";
import type { ApplicationRecord } from "../../../lib/applications";
import {
  APPLICATION_STATUSES,
  APPLICATIONS_LIST_CLARIFICATION_FILTERS,
  applicationsListQueryString,
  buildApplicationsListFilter,
  buildApplicationsListSort,
  formatApplicationStatusLabel,
  parseApplicationsListParams,
} from "../../../lib/recruiter-applications-list";
import { recruiterApplicationsIndexErrors } from "../../../lib/recruiter-flash";
import { getCompanyName } from "../../../lib/site";

export const prerender = false;

const { pb } = Astro.locals.recruiter!;
const companyName = getCompanyName();
const now = new Date();

const listParams = parseApplicationsListParams(Astro.url.searchParams);
const errorCode = Astro.url.searchParams.get("error");
const errorMsg = errorCode ? recruiterApplicationsIndexErrors[errorCode] : undefined;

const PER_PAGE = 25;
const filter = buildApplicationsListFilter(pb, listParams);
const sort = buildApplicationsListSort(listParams);

const [list, jobs] = await Promise.all([
  pb.collection("applications").getList<ApplicationRecord>(listParams.page, PER_PAGE, {
    sort,
    expand: "job",
    ...(filter ? { filter } : {}),
  }),
  pb.collection("jobs").getFullList({
    sort: "title",
    requestKey: "recruiter_applications_filter_jobs",
  }),
]);

if (list.totalPages > 0 && listParams.page > list.totalPages) {
  return Astro.redirect(
    `/recruiter/applications${applicationsListQueryString({ ...listParams, page: list.totalPages }, errorCode ? { error: errorCode } : {})}`,
  );
}

const hasActiveFilters = Boolean(
  listParams.q || listParams.job || listParams.status || listParams.clarification,
);
const refreshHref = `${Astro.url.pathname}${Astro.url.search}`;

const clarificationFilterLabels: Record<(typeof APPLICATIONS_LIST_CLARIFICATION_FILTERS)[number], string> = {
  none: "None",
  waiting: "Waiting for candidate",
  answered: "Answers received",
  needs_followup: "Needs follow-up",
};
---

<RecruiterLayout title={`Applications | ${companyName}`}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Applications</h1>
      <p class="mt-1 text-sm text-slate-600">All candidate submissions.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a class="btn-secondary btn-sm no-underline" href={refreshHref} aria-label="Refresh applications list">
        Refresh
      </a>
      <a class="btn-secondary btn-sm no-underline" href="/recruiter/jobs">View jobs</a>
    </div>
  </div>

  {
    errorMsg && (
      <p class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900">{errorMsg}</p>
    )
  }

  <form class="mt-6 rounded-lg border border-slate-200 bg-white p-4 shadow-sm" method="get" action="/recruiter/applications">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2">
        <label class="mb-1 block text-xs font-medium text-slate-600" for="filter-q">Search name or email</label>
        <input
          id="filter-q"
          name="q"
          type="search"
          value={listParams.q}
          placeholder="Search by name or email"
          class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
        />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-slate-600" for="filter-job">Job</label>
        <select
          id="filter-job"
          name="job"
          class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
        >
          <option value="">All jobs</option>
          {jobs.map((job) => (
            <option value={job.id} selected={listParams.job === job.id}>
              {String(job.title ?? job.id)}
            </option>
          ))}
        </select>
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-slate-600" for="filter-status">Status</label>
        <select
          id="filter-status"
          name="status"
          class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
        >
          <option value="">All statuses</option>
          {APPLICATION_STATUSES.map((status) => (
            <option value={status} selected={listParams.status === status}>
              {formatApplicationStatusLabel(status)}
            </option>
          ))}
        </select>
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-slate-600" for="filter-clarification">Clarification</label>
        <select
          id="filter-clarification"
          name="clarification"
          class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
        >
          <option value="">All</option>
          {APPLICATIONS_LIST_CLARIFICATION_FILTERS.map((value) => (
            <option value={value} selected={listParams.clarification === value}>
              {clarificationFilterLabels[value]}
            </option>
          ))}
        </select>
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-slate-600" for="filter-sort">Sort by</label>
        <select
          id="filter-sort"
          name="sort"
          class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
        >
          <option value="submitted" selected={listParams.sort === "submitted"}>Submitted date</option>
          <option value="updated" selected={listParams.sort === "updated"}>Last updated</option>
          <option value="cv_fit" selected={listParams.sort === "cv_fit"}>CV fit score</option>
          <option value="required" selected={listParams.sort === "required"}>Required skills score</option>
          <option value="nice_to_have" selected={listParams.sort === "nice_to_have"}>Nice-to-have score</option>
        </select>
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-slate-600" for="filter-dir">Direction</label>
        <select
          id="filter-dir"
          name="dir"
          class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
        >
          <option value="desc" selected={listParams.dir === "desc"}>Descending</option>
          <option value="asc" selected={listParams.dir === "asc"}>Ascending</option>
        </select>
      </div>
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      <button type="submit" class="btn-primary btn-sm">Apply filters</button>
      {hasActiveFilters ? (
        <a class="btn-secondary btn-sm no-underline" href="/recruiter/applications">
          Clear filters
        </a>
      ) : null}
    </div>
  </form>

  <div class="mt-8 overflow-hidden rounded-lg border border-slate-200 bg-white">
    {
      list.items.length === 0 ? (
        <p class="px-4 py-8 text-sm text-slate-600">
          {hasActiveFilters ? "No applications match your filters." : "No applications yet."}
        </p>
      ) : (
        <>
          <div class="lg:hidden">
            {list.items.map((row) => (
              <ApplicationInboxRow row={row} now={now} layout="mobile" />
            ))}
          </div>
          <div class={applicationInboxTableClass}>
            <span class={applicationInboxHeaderCellClass}>Candidate</span>
            <span class={applicationInboxHeaderCellClass}>Dates</span>
            <span class={applicationInboxHeaderCellClass}>Workflow</span>
            <span class={applicationInboxHeaderCellClass}>AI scores</span>
            <span class:list={[applicationInboxHeaderCellClass, "text-right"]}>Action</span>
            {list.items.map((row) => (
              <ApplicationInboxRow row={row} now={now} layout="desktop" />
            ))}
          </div>
        </>
      )
    }
  </div>

  {
    list.totalPages > 1 && (
      <nav class="mt-6 flex flex-wrap items-center justify-between gap-3 text-sm text-slate-600" aria-label="Applications pagination">
        <div>
          {listParams.page > 1 ? (
            <a
              class="text-teal-800 hover:text-teal-900"
              href={`/recruiter/applications${applicationsListQueryString({ ...listParams, page: listParams.page - 1 }, errorCode ? { error: errorCode } : {})}`}
            >
              ← Previous
            </a>
          ) : (
            <span class="text-slate-400">← Previous</span>
          )}
        </div>
        <span>
          Page {listParams.page} of {list.totalPages}
          {list.totalItems != null ? ` · ${list.totalItems} total` : ""}
        </span>
        <div>
          {listParams.page < list.totalPages ? (
            <a
              class="text-teal-800 hover:text-teal-900"
              href={`/recruiter/applications${applicationsListQueryString({ ...listParams, page: listParams.page + 1 }, errorCode ? { error: errorCode } : {})}`}
            >
              Next →
            </a>
          ) : (
            <span class="text-slate-400">Next →</span>
          )}
        </div>
      </nav>
    )
  }
</RecruiterLayout>
