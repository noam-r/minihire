---
import RecruiterLayout from "../../../layouts/RecruiterLayout.astro";
import { recruiterApplicationsIndexErrors } from "../../../lib/recruiter-flash";
import { formatRelativeTime } from "../../../lib/relative-time";
import { getCompanyName } from "../../../lib/site";

export const prerender = false;

const { pb } = Astro.locals.recruiter!;
const companyName = getCompanyName();
const now = new Date();

const errorCode = Astro.url.searchParams.get("error");
const errorMsg = errorCode ? recruiterApplicationsIndexErrors[errorCode] : undefined;
const errorQuery =
  errorCode && recruiterApplicationsIndexErrors[errorCode]
    ? `&error=${encodeURIComponent(errorCode)}`
    : "";

const PER_PAGE = 25;
const pageRaw = Astro.url.searchParams.get("page");
const page = Math.max(1, Number.parseInt(pageRaw || "1", 10) || 1);

const list = await pb.collection("applications").getList(page, PER_PAGE, {
  sort: "-submitted_at",
  expand: "job",
});

if (list.totalPages > 0 && page > list.totalPages) {
  const qs = new URLSearchParams();
  qs.set("page", String(list.totalPages));
  if (errorCode && recruiterApplicationsIndexErrors[errorCode]) {
    qs.set("error", errorCode);
  }
  return Astro.redirect(`/recruiter/applications?${qs}`);
}
---

<RecruiterLayout title={`Applications | ${companyName}`}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Applications</h1>
      <p class="mt-1 text-sm text-slate-600">All candidate submissions.</p>
    </div>
    <a class="btn-secondary btn-sm" href="/recruiter/jobs">View jobs</a>
  </div>

  {
    errorMsg && (
      <p class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900">{errorMsg}</p>
    )
  }

  <div class="mt-8 overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-600">
        <tr>
          <th class="px-4 py-3">Candidate</th>
          <th class="px-4 py-3">Job</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Submitted</th>
          <th class="px-4 py-3 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {
          list.items.length === 0 ? (
            <tr>
              <td class="px-4 py-6 text-slate-600" colspan="5">
                No applications yet.
              </td>
            </tr>
          ) : (
            list.items.map((row) => {
              const job = row.expand?.job as { title?: string } | undefined;
              return (
                <tr>
                  <td class="px-4 py-3">
                    <div class="font-medium text-slate-900">{row.full_name}</div>
                    <div class="text-xs text-slate-500">{row.email}</div>
                  </td>
                  <td class="px-4 py-3 text-slate-700">{job?.title ?? "—"}</td>
                  <td class="px-4 py-3 text-slate-700">{row.status}</td>
                  <td class="px-4 py-3 text-slate-600">
                    <div class="font-medium text-slate-800">{formatRelativeTime(row.submitted_at, now)}</div>
                    <div class="text-xs text-slate-500">{String(row.submitted_at ?? "").slice(0, 19).replace("T", " ")}</div>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <a class="btn-primary btn-sm inline-flex no-underline" href={`/recruiter/applications/${row.id}`}>
                      Open
                    </a>
                  </td>
                </tr>
              );
            })
          )
        }
      </tbody>
    </table>
  </div>

  {
    list.totalPages > 1 && (
      <nav class="mt-6 flex flex-wrap items-center justify-between gap-3 text-sm text-slate-600" aria-label="Applications pagination">
        <div>
          {page > 1 ? (
            <a class="text-teal-800 hover:text-teal-900" href={`/recruiter/applications?page=${page - 1}${errorQuery}`}>
              ← Previous
            </a>
          ) : (
            <span class="text-slate-400">← Previous</span>
          )}
        </div>
        <span>
          Page {page} of {list.totalPages}
          {list.totalItems != null ? ` · ${list.totalItems} total` : ""}
        </span>
        <div>
          {page < list.totalPages ? (
            <a class="text-teal-800 hover:text-teal-900" href={`/recruiter/applications?page=${page + 1}${errorQuery}`}>
              Next →
            </a>
          ) : (
            <span class="text-slate-400">Next →</span>
          )}
        </div>
      </nav>
    )
  }
</RecruiterLayout>
