---
import RecruiterLayout from "../../layouts/RecruiterLayout.astro";
import { formatRelativeTime } from "../../lib/relative-time";
import { getCompanyName } from "../../lib/site";

export const prerender = false;

const { pb } = Astro.locals.recruiter!;
const companyName = getCompanyName();
const now = new Date();

const [publishedMeta, appsMeta, recent, newestPublishedList, latestSubmissionList] = await Promise.all([
  pb.collection("jobs").getList(1, 1, {
    filter: 'status = "published"',
    requestKey: "recruiter_dash_jobs_published_count",
  }),
  pb.collection("applications").getList(1, 1, {
    requestKey: "recruiter_dash_apps_total_count",
  }),
  pb.collection("applications").getList(1, 8, {
    sort: "-submitted_at",
    expand: "job",
    requestKey: "recruiter_dash_apps_recent",
  }),
  pb.collection("jobs").getList(1, 1, {
    filter: 'status = "published"',
    sort: "-publishedAt",
    requestKey: "recruiter_dash_jobs_newest_published",
  }),
  pb.collection("applications").getList(1, 1, {
    sort: "-submitted_at",
    expand: "job",
    requestKey: "recruiter_dash_apps_latest_submission",
  }),
]);

const publishedJobs = publishedMeta.totalItems;
const totalApplications = appsMeta.totalItems;
const newestPublished = newestPublishedList.items[0];
const latestApp = latestSubmissionList.items[0];
---

<RecruiterLayout title={`Recruiter | ${companyName}`}>
  <h1 class="text-2xl font-semibold text-slate-900">Dashboard</h1>
  <p class="mt-1 text-sm text-slate-600">Overview of roles and candidate submissions.</p>

  <section class="mt-8 rounded-lg border border-slate-200 bg-white p-6 shadow-sm" aria-labelledby="quick-actions-heading">
    <h2 id="quick-actions-heading" class="text-base font-semibold text-slate-900">
      What do you want to do?
    </h2>
    <p class="mt-1 text-sm text-slate-600">Jump straight into the main areas of the portal.</p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a class="btn-primary btn-md" href="/recruiter/applications">Review applications</a>
      <a class="btn-secondary btn-md" href="/recruiter/jobs">Manage jobs</a>
    </div>
  </section>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs font-medium uppercase tracking-wide text-slate-500">Published jobs</div>
      <div class="mt-2 text-2xl font-semibold text-slate-900">{publishedJobs}</div>
      {
        newestPublished && (
          <p class="mt-3 text-xs leading-relaxed text-slate-600">
            Most recent listing: <span class="font-medium text-slate-800">{newestPublished.title}</span>
            {typeof newestPublished.publishedAt === "string" && newestPublished.publishedAt.trim() !== "" ? (
              <>
                {" "}
                · published <span class="font-medium text-slate-800">{formatRelativeTime(newestPublished.publishedAt, now)}</span>
              </>
            ) : (
              <span> · publish date not set</span>
            )}
          </p>
        )
      }
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs font-medium uppercase tracking-wide text-slate-500">Applications</div>
      <div class="mt-2 text-2xl font-semibold text-slate-900">{totalApplications}</div>
      {
        latestApp && (
          <p class="mt-3 text-xs leading-relaxed text-slate-600">
            Latest submission: <span class="font-medium text-slate-800">{latestApp.full_name}</span>
            {" · received "}
            <span class="font-medium text-slate-800">{formatRelativeTime(latestApp.submitted_at, now)}</span>
          </p>
        )
      }
    </div>
    <div class="rounded-lg border border-teal-100 bg-teal-50/60 p-5 shadow-sm sm:col-span-2 lg:col-span-1">
      <div class="text-xs font-medium uppercase tracking-wide text-teal-800">Shortcuts</div>
      <ul class="mt-3 space-y-2 text-sm text-teal-950">
        <li>
          <a class="font-medium underline decoration-teal-400 underline-offset-2 hover:text-teal-900" href="/recruiter/applications">
            Open applications inbox →
          </a>
        </li>
        <li>
          <a class="font-medium underline decoration-teal-400 underline-offset-2 hover:text-teal-900" href="/recruiter/jobs">
            Open jobs list →
          </a>
        </li>
      </ul>
    </div>
  </div>

  <section class="mt-10" aria-labelledby="recent-apps-heading">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 id="recent-apps-heading" class="text-lg font-semibold text-slate-900">Recent applications</h2>
      <a class="btn-secondary btn-sm shrink-0" href="/recruiter/applications">View all applications</a>
    </div>
    <ul class="mt-4 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      {
        recent.items.length === 0 ? (
          <li class="px-4 py-6 text-sm text-slate-600">No applications yet.</li>
        ) : (
          recent.items.map((app) => {
            const job = app.expand?.job as { title?: string } | undefined;
            return (
              <li class="flex flex-col gap-3 px-4 py-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
                <div class="min-w-0 flex-1">
                  <div class="font-medium text-slate-900">{app.full_name}</div>
                  <div class="text-sm text-slate-600">{job?.title ?? "Job"}</div>
                  <div class="mt-1 text-xs text-slate-500">
                    Submitted <span class="font-medium text-slate-700">{formatRelativeTime(app.submitted_at, now)}</span>
                    {app.submitted_at ? (
                      <span class="text-slate-400"> · {String(app.submitted_at).slice(0, 19).replace("T", " ")}</span>
                    ) : null}
                  </div>
                </div>
                <a class="btn-primary btn-sm w-full shrink-0 sm:w-auto" href={`/recruiter/applications/${app.id}`}>
                  Open application
                </a>
              </li>
            );
          })
        )
      }
    </ul>
  </section>
</RecruiterLayout>
