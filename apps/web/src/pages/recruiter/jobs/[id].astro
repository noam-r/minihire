---
import MarkdownContent from "../../../components/MarkdownContent.astro";
import RecruiterLayout from "../../../layouts/RecruiterLayout.astro";
import { JOB_STATUSES } from "../../../lib/job-statuses";
import { recruiterJobDetailErrors } from "../../../lib/recruiter-flash";
import { ensureSessionCsrfCookie } from "../../../lib/recruiter-auth/cookies";
import { formatRelativeTime, jobPostingTimingLine } from "../../../lib/relative-time";
import { getCompanyName } from "../../../lib/site";

export const prerender = false;

function publishedAtForInput(raw: unknown): string {
  if (raw == null || raw === "") {
    return "";
  }
  const s = typeof raw === "string" ? raw : String(raw);
  const d = new Date(s);
  if (Number.isNaN(d.getTime())) {
    return "";
  }
  const pad = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

const jobId = Astro.params.id;
if (!jobId) {
  return Astro.redirect("/recruiter/jobs");
}

const { pb, user } = Astro.locals.recruiter!;
const csrf = ensureSessionCsrfCookie(Astro.cookies);
const companyName = getCompanyName();
const isAdmin = user.role === "admin";
const now = new Date();

const flash = {
  updated: Astro.url.searchParams.get("updated") === "1",
  error: Astro.url.searchParams.get("error"),
};
const errorMsg = flash.error ? recruiterJobDetailErrors[flash.error] : undefined;

let job;
try {
  job = await pb.collection("jobs").getOne(jobId);
} catch {
  return Astro.redirect("/recruiter/jobs");
}

const apps = await pb.collection("applications").getFullList({
  filter: pb.filter("job = {:jid}", { jid: job.id }),
  sort: "-submitted_at",
});

const publishedAtValue = publishedAtForInput(job.publishedAt);
const postingTiming = jobPostingTimingLine(job, now);
---

<RecruiterLayout title={`${job.title} | ${companyName}`}>
  <p class="text-sm text-slate-600">
    <a class="text-teal-800 hover:text-teal-900" href="/recruiter/jobs">← Jobs</a>
  </p>
  <h1 class="mt-2 text-2xl font-semibold text-slate-900">{job.title}</h1>
  <p class="text-sm text-slate-600">
    Status: <span class="font-medium text-slate-800">{job.status}</span>
    {postingTiming ? (
      <>
        {" "}
        · <span class="text-slate-700">{postingTiming}</span>
      </>
    ) : null}
  </p>
  {
    flash.updated && (
      <p class="mt-4 rounded-md border border-teal-200 bg-teal-50 px-3 py-2 text-sm text-teal-900">Job saved.</p>
    )
  }
  {
    errorMsg && (
      <p class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900">{errorMsg}</p>
    )
  }
  {
    job.status === "published" && typeof job.slug === "string" && job.slug.length > 0 && (
      <p class="mt-3 text-sm">
        <a
          class="btn-secondary btn-sm inline-flex no-underline"
          href={`/jobs/${job.slug}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          View public listing ↗
        </a>
      </p>
    )
  }

  <section id="job-overview" class="mt-10 max-w-3xl scroll-mt-24 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <h2 class="text-lg font-semibold text-slate-900">Role overview</h2>
      {
        isAdmin && (
          <a class="btn-secondary btn-sm shrink-0 no-underline" href="#edit-job">
            Edit job fields
          </a>
        )
      }
    </div>
    <p class="mt-3 text-sm leading-relaxed text-slate-700">{job.summary}</p>
    <div class="mt-6 border-t border-slate-100 pt-6">
      <h3 class="text-sm font-semibold text-slate-800">Full description</h3>
      <MarkdownContent
        content={typeof job.description === "string" ? job.description : ""}
        class="mt-3 max-w-none"
      />
    </div>
  </section>

  {
    isAdmin && (
      <section class="mt-10 max-w-3xl scroll-mt-24 rounded-lg border border-slate-200 bg-white p-6 shadow-sm" id="edit-job">
        <h2 class="text-lg font-semibold text-slate-900">Edit job (admin)</h2>
        <p class="mt-1 text-sm text-slate-600">
          Changes apply immediately to PocketBase. Slug must stay unique across all jobs.
        </p>
        <form method="post" action="/recruiter/actions/job-update" class="mt-6 space-y-4">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="job_id" value={job.id} />
          <div>
            <label class="mb-1 block text-sm font-medium text-slate-700" for="title">Title</label>
            <input
              id="title"
              name="title"
              type="text"
              required
              maxlength={200}
              value={job.title}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
            />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-slate-700" for="slug">Slug</label>
            <input
              id="slug"
              name="slug"
              type="text"
              required
              maxlength={120}
              pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
              title="Lowercase letters, numbers, and hyphens only"
              value={job.slug}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
            />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-slate-700" for="summary">Summary</label>
            <textarea
              id="summary"
              name="summary"
              required
              maxlength={1000}
              rows={3}
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600">{job.summary}</textarea>
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-slate-700" for="job-description-input">Description (Markdown)</label>
            <textarea
              id="job-description-input"
              name="description"
              required
              rows={12}
              class="w-full rounded-md border border-slate-300 px-3 py-2 font-mono text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600">{job.description}</textarea>
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-slate-700" for="status">Status</label>
            <select
              id="status"
              name="status"
              class="w-full max-w-xs rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
            >
              {JOB_STATUSES.map((s) => (
                <option value={s} selected={s === job.status}>
                  {s}
                </option>
              ))}
            </select>
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-slate-700" for="published_at">Published at (optional)</label>
            <input
              id="published_at"
              name="published_at"
              type="datetime-local"
              value={publishedAtValue}
              class="w-full max-w-xs rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
            />
            <p class="mt-1 text-xs text-slate-500">Leave empty to keep the current value unchanged.</p>
          </div>
          <button type="submit" class="btn-primary btn-sm">
            Save job
          </button>
        </form>
      </section>
    )
  }

  <section id="applications" class="mt-10 scroll-mt-24">
    <h2 class="text-lg font-semibold text-slate-900">Applications ({apps.length})</h2>
    <ul class="mt-4 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      {
        apps.length === 0 ? (
          <li class="px-4 py-6 text-sm text-slate-600">No applications for this job.</li>
        ) : (
          apps.map((a) => (
            <li class="flex flex-col gap-2 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0">
                <div class="font-medium text-slate-900">{a.full_name}</div>
                <div class="text-sm text-slate-600">{a.status}</div>
                <div class="mt-1 text-xs text-slate-500">
                  Received <span class="font-medium text-slate-700">{formatRelativeTime(a.submitted_at, now)}</span>
                  {a.submitted_at ? (
                    <span class="text-slate-400"> · {String(a.submitted_at).slice(0, 19).replace("T", " ")}</span>
                  ) : null}
                </div>
              </div>
              <a class="btn-primary btn-sm w-full shrink-0 sm:w-auto" href={`/recruiter/applications/${a.id}`}>
                Open application
              </a>
            </li>
          ))
        )
      }
    </ul>
  </section>
</RecruiterLayout>
