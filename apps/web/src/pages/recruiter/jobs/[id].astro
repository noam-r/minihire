---
import MarkdownContent from "../../../components/MarkdownContent.astro";
import RecruiterLayout from "../../../layouts/RecruiterLayout.astro";
import { formatEmploymentType, formatWorkModel } from "../../../lib/jobs";
import { JOB_STATUSES } from "../../../lib/job-statuses";
import { NOT_PROVIDED, optionalApplicantText } from "../../../lib/recruiter-application-display";
import { recruiterJobDetailErrors } from "../../../lib/recruiter-flash";
import { ensureSessionCsrfCookie } from "../../../lib/recruiter-auth/cookies";
import { formatRelativeTime, jobPostingTimingLine } from "../../../lib/relative-time";
import { splitLinesToList } from "../../../lib/sanitize";
import { getCompanyName } from "../../../lib/site";

export const prerender = false;

const RECENT_APPLICATIONS = 15;

function publishedAtForInput(raw: unknown): string {
  if (raw == null || raw === "") {
    return "";
  }
  const s = typeof raw === "string" ? raw : String(raw);
  const d = new Date(s);
  if (Number.isNaN(d.getTime())) {
    return "";
  }
  const pad = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function formatJobPublishedAtDisplay(raw: unknown): string {
  if (raw == null || raw === "") {
    return NOT_PROVIDED;
  }
  const d = new Date(typeof raw === "string" ? raw : String(raw));
  if (Number.isNaN(d.getTime())) {
    return NOT_PROVIDED;
  }
  return `${d.toISOString().slice(0, 19).replace("T", " ")} UTC`;
}

function jobText(raw: unknown): string {
  return typeof raw === "string" ? raw.trim() : String(raw ?? "").trim();
}

const jobId = Astro.params.id;
if (!jobId) {
  return Astro.redirect("/recruiter/jobs");
}

const { pb, user } = Astro.locals.recruiter!;
const csrf = ensureSessionCsrfCookie(Astro.cookies);
const companyName = getCompanyName();
const isAdmin = user.role === "admin";
const now = new Date();

const flash = {
  updated: Astro.url.searchParams.get("updated") === "1",
  error: Astro.url.searchParams.get("error"),
};
const errorMsg = flash.error ? recruiterJobDetailErrors[flash.error] : undefined;

let job;
try {
  job = await pb.collection("jobs").getOne(jobId);
} catch {
  return Astro.redirect("/recruiter/jobs");
}

const appsResult = await pb.collection("applications").getList(1, RECENT_APPLICATIONS, {
  filter: pb.filter("job = {:jid}", { jid: job.id }),
  sort: "-submitted_at",
});
const recentApps = appsResult.items;
const totalAppCount = appsResult.totalItems;

const publishedAtValue = publishedAtForInput(job.publishedAt);
const postingTiming = jobPostingTimingLine(job, now);

const descriptionMd = jobText(job.description);
const whatToExpectMd = jobText(job.whatToExpect);
const hiringProcessMd = jobText(job.hiringProcess);
const requiredLines = splitLinesToList(typeof job.requiredSkills === "string" ? job.requiredSkills : "");
const niceLines = splitLinesToList(typeof job.niceToHaveSkills === "string" ? job.niceToHaveSkills : "");

const workModelLabel = formatWorkModel(job.workModel as "remote" | "hybrid" | "onsite");
const employmentLabel = formatEmploymentType(job.employmentType as "full_time" | "part_time" | "contract" | "internship");

const editSummaryClass =
  "cursor-pointer select-none rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-teal-800 shadow-sm hover:bg-slate-50 list-none [&::-webkit-details-marker]:hidden";
---

<RecruiterLayout title={`${job.title} | ${companyName}`}>
  <div class="mb-6 border-b border-slate-200 pb-6">
    <p class="text-sm text-slate-600">
      <a class="text-teal-800 hover:text-teal-900" href="/recruiter/jobs">← Jobs</a>
      <span class="mx-2 text-slate-300">|</span>
      <a class="text-teal-800 hover:text-teal-900" href="/recruiter/applications">Applications</a>
    </p>
    <div class="mt-2 flex flex-wrap items-start justify-between gap-3">
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 md:text-3xl">{job.title}</h1>
      {
        isAdmin && (
          <details class="min-w-0 shrink-0 rounded-lg border border-slate-200 bg-slate-50/80 open:bg-white open:shadow-sm">
            <summary class={editSummaryClass}>Edit title</summary>
            <form method="post" action="/recruiter/actions/job-update" class="border-t border-slate-200 p-3">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="job_id" value={job.id} />
              <label class="block text-xs font-medium text-slate-700" for="edit-title">Title</label>
              <input
                id="edit-title"
                name="title"
                type="text"
                required
                maxlength={200}
                value={job.title}
                class="mt-1 w-full min-w-[12rem] rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
              />
              <button type="submit" class="btn-primary btn-sm mt-2 w-full justify-center">
                Save title
              </button>
            </form>
          </details>
        )
      }
    </div>
    <p class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm text-slate-600">
      <span class="font-medium text-slate-700">Listing status:</span>
      <span class="font-medium text-slate-900">{job.status}</span>
      {
        postingTiming ? (
          <>
            <span class="hidden sm:inline text-slate-300" aria-hidden="true">
              ·
            </span>
            <span class="text-slate-700">{postingTiming}</span>
          </>
        ) : null
      }
    </p>
  </div>

  {
    flash.updated && (
      <p class="mb-6 rounded-md border border-teal-200 bg-teal-50 px-3 py-2 text-sm text-teal-900">Job saved.</p>
    )
  }
  {
    errorMsg && (
      <p class="mb-6 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900">{errorMsg}</p>
    )
  }

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(280px,22rem)] lg:items-start lg:gap-10">
    <div class="min-w-0 space-y-6" role="region" aria-labelledby="job-detail-heading">
      <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <header class="border-b border-slate-100 bg-slate-50/80 px-5 py-4">
          <h2 id="job-detail-heading" class="text-base font-semibold text-slate-900">Job</h2>
          <p class="mt-1 text-xs leading-relaxed text-slate-600">
            One view of the listing. Admins: use Edit to change a field; other values stay as they are.
          </p>
        </header>

        <div class="divide-y divide-slate-100">
          <div class="px-5 py-4">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Slug & URL</h3>
              {
                isAdmin && (
                  <details class="rounded-lg border border-slate-200 bg-slate-50/80 open:bg-white open:shadow-sm">
                    <summary class={editSummaryClass}>Edit slug</summary>
                    <form method="post" action="/recruiter/actions/job-update" class="border-t border-slate-200 p-3">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="job_id" value={job.id} />
                      <label class="block text-xs font-medium text-slate-700" for="edit-slug">Slug</label>
                      <input
                        id="edit-slug"
                        name="slug"
                        type="text"
                        required
                        maxlength={120}
                        pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                        title="Lowercase letters, numbers, and hyphens only"
                        value={job.slug}
                        class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 font-mono text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
                      />
                      <button type="submit" class="btn-primary btn-sm mt-2 w-full justify-center">Save slug</button>
                    </form>
                  </details>
                )
              }
            </div>
            <p class="mt-2 break-all font-mono text-sm text-slate-800">{job.slug}</p>
          </div>

          <div class="px-5 py-4">
            <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Work & employment</h3>
            <dl class="mt-3 space-y-2 text-sm text-slate-800">
              <div class="flex flex-col gap-0.5 sm:flex-row sm:justify-between sm:gap-4">
                <dt class="font-medium text-slate-600">Work model</dt>
                <dd class="sm:text-right">{workModelLabel}</dd>
              </div>
              <div class="flex flex-col gap-0.5 sm:flex-row sm:justify-between sm:gap-4">
                <dt class="font-medium text-slate-600">Employment type</dt>
                <dd class="sm:text-right">{employmentLabel}</dd>
              </div>
              <div class="flex flex-col gap-0.5 sm:flex-row sm:justify-between sm:gap-4">
                <dt class="font-medium text-slate-600">Work location</dt>
                <dd class="min-w-0 break-words sm:max-w-[70%] sm:text-right">{optionalApplicantText(job.workLocation)}</dd>
              </div>
            </dl>
            <p class="mt-3 text-xs text-slate-500">Work model, type, and location are edited in PocketBase Admin.</p>
          </div>

          <div class="px-5 py-4">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Publishing</h3>
              {
                isAdmin && (
                  <details class="rounded-lg border border-slate-200 bg-slate-50/80 open:bg-white open:shadow-sm">
                    <summary class={editSummaryClass}>Edit status & date</summary>
                    <form method="post" action="/recruiter/actions/job-update" class="space-y-3 border-t border-slate-200 p-3">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="job_id" value={job.id} />
                      <div>
                        <label class="block text-xs font-medium text-slate-700" for="edit-status">Listing status</label>
                        <select
                          id="edit-status"
                          name="status"
                          class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
                        >
                          {JOB_STATUSES.map((s) => (
                            <option value={s} selected={s === job.status}>
                              {s}
                            </option>
                          ))}
                        </select>
                      </div>
                      <div>
                        <label class="block text-xs font-medium text-slate-700" for="edit-published-at">Published at</label>
                        <input
                          id="edit-published-at"
                          name="published_at"
                          type="datetime-local"
                          value={publishedAtValue}
                          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600"
                        />
                        <p class="mt-1 text-xs text-slate-500">Leave blank to keep the current published date.</p>
                      </div>
                      <button type="submit" class="btn-primary btn-sm w-full justify-center">Save</button>
                    </form>
                  </details>
                )
              }
            </div>
            <dl class="mt-3 space-y-2 text-sm">
              <div class="flex flex-col gap-0.5 sm:flex-row sm:justify-between sm:gap-4">
                <dt class="font-medium text-slate-600">Status</dt>
                <dd class="font-medium text-slate-900 sm:text-right">{job.status}</dd>
              </div>
              <div class="flex flex-col gap-0.5 sm:flex-row sm:justify-between sm:gap-4">
                <dt class="font-medium text-slate-600">Published at</dt>
                <dd class="font-mono text-xs text-slate-800 sm:text-right">{formatJobPublishedAtDisplay(job.publishedAt)}</dd>
              </div>
            </dl>
          </div>

          <div class="px-5 py-4">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Summary</h3>
              {
                isAdmin && (
                  <details class="rounded-lg border border-slate-200 bg-slate-50/80 open:bg-white open:shadow-sm">
                    <summary class={editSummaryClass}>Edit summary</summary>
                    <form method="post" action="/recruiter/actions/job-update" class="border-t border-slate-200 p-3">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="job_id" value={job.id} />
                      <textarea
                        name="summary"
                        required
                        maxlength={1000}
                        rows={5}
                        class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600">{job.summary}</textarea>
                      <button type="submit" class="btn-primary btn-sm mt-2 w-full justify-center">Save summary</button>
                    </form>
                  </details>
                )
              }
            </div>
            <p class="mt-2 text-sm leading-relaxed text-slate-800">{job.summary}</p>
          </div>

          <div class="min-w-0 px-5 py-4">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Description</h3>
              {
                isAdmin && (
                  <details class="max-w-full rounded-lg border border-slate-200 bg-slate-50/80 open:bg-white open:shadow-sm">
                    <summary class={editSummaryClass}>Edit description</summary>
                    <form method="post" action="/recruiter/actions/job-update" class="border-t border-slate-200 p-3">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="job_id" value={job.id} />
                      <textarea
                        name="description"
                        required
                        rows={14}
                        class="w-full max-w-full rounded-md border border-slate-300 px-3 py-2 font-mono text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600">{job.description}</textarea>
                      <button type="submit" class="btn-primary btn-sm mt-2 w-full justify-center">Save description</button>
                    </form>
                  </details>
                )
              }
            </div>
            <div class="mt-2 max-w-none overflow-x-auto break-words">
              <MarkdownContent content={descriptionMd} class="mt-0" />
            </div>
          </div>

          <div class="min-w-0 px-5 py-4">
            <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">What to expect</h3>
            {
              whatToExpectMd ? (
                <div class="mt-2 max-w-none overflow-x-auto break-words">
                  <MarkdownContent content={whatToExpectMd} class="mt-0" />
                </div>
              ) : (
                <p class="mt-2 text-sm text-slate-500">{NOT_PROVIDED}</p>
              )
            }
          </div>

          <div class="grid gap-6 px-5 py-4 sm:grid-cols-2">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Required skills</h3>
              {
                requiredLines.length > 0 ? (
                  <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-800">
                    {requiredLines.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                ) : (
                  <p class="mt-2 text-sm text-slate-500">{NOT_PROVIDED}</p>
                )
              }
            </div>
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Nice to have</h3>
              {
                niceLines.length > 0 ? (
                  <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-800">
                    {niceLines.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                ) : (
                  <p class="mt-2 text-sm text-slate-500">{NOT_PROVIDED}</p>
                )
              }
            </div>
          </div>

          <div class="min-w-0 px-5 py-4">
            <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Hiring process</h3>
            {
              hiringProcessMd ? (
                <div class="mt-2 max-w-none overflow-x-auto break-words">
                  <MarkdownContent content={hiringProcessMd} class="mt-0" />
                </div>
              ) : (
                <p class="mt-2 text-sm text-slate-500">{NOT_PROVIDED}</p>
              )
            }
          </div>
        </div>
      </section>
    </div>

    <aside class="min-w-0 space-y-4 lg:sticky lg:top-6" aria-labelledby="recent-applications-heading">
      <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <header class="flex flex-wrap items-end justify-between gap-2 border-b border-slate-100 px-5 py-3">
          <div>
            <h2 id="recent-applications-heading" class="text-sm font-semibold text-slate-900">Recent candidates</h2>
            <p class="text-xs text-slate-500">
              Latest {RECENT_APPLICATIONS}
              {totalAppCount > RECENT_APPLICATIONS ? (
                <>
                  {" "}
                  of <span class="font-medium text-slate-700">{totalAppCount}</span> total
                </>
              ) : (
                ""
              )}
            </p>
          </div>
          {
            job.status === "published" && typeof job.slug === "string" && job.slug.length > 0 ? (
              <a
                class="btn-secondary btn-sm shrink-0 no-underline"
                href={`/jobs/${job.slug}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Public listing ↗
              </a>
            ) : null
          }
        </header>
        <ul class="max-h-[min(32rem,60vh)] divide-y divide-slate-100 overflow-y-auto text-sm">
          {
            recentApps.length === 0 ? (
              <li class="px-4 py-6 text-slate-600">No applications for this job.</li>
            ) : (
              recentApps.map((a) => (
                <li class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
                  <div class="min-w-0">
                    <div class="font-medium text-slate-900">{a.full_name}</div>
                    <div class="text-xs text-slate-600">
                      <span class="font-medium text-slate-800">{a.status}</span>
                      <span class="text-slate-400"> · </span>
                      <span>{formatRelativeTime(a.submitted_at, now)}</span>
                      {a.submitted_at ? (
                        <span class="text-slate-400"> · {String(a.submitted_at).slice(0, 19).replace("T", " ")}</span>
                      ) : null}
                    </div>
                  </div>
                  <a class="btn-primary btn-sm w-full shrink-0 justify-center sm:w-auto" href={`/recruiter/applications/${a.id}`}>
                    Open
                  </a>
                </li>
              ))
            )
          }
        </ul>
        {
          totalAppCount > RECENT_APPLICATIONS ? (
            <p class="border-t border-slate-100 px-4 py-3 text-center text-xs text-slate-600">
              <a class="font-medium text-teal-800 hover:text-teal-900" href="/recruiter/applications">
                View all applications
              </a>{" "}
              for older submissions.
            </p>
          ) : null
        }
      </section>
    </aside>
  </div>
</RecruiterLayout>
