---
import RecruiterLayout from "../../../layouts/RecruiterLayout.astro";
import { recruiterJobsIndexErrors } from "../../../lib/recruiter-flash";
import { jobApplicationCounts } from "../../../lib/recruiter-job-stats";
import { jobPostingTimingLine } from "../../../lib/relative-time";
import { getCompanyName } from "../../../lib/site";

export const prerender = false;

const { pb } = Astro.locals.recruiter!;
const companyName = getCompanyName();
const now = new Date();

const errorCode = Astro.url.searchParams.get("error");
const errorMsg = errorCode ? recruiterJobsIndexErrors[errorCode] : undefined;

const [jobs, appCountByJob] = await Promise.all([
  pb.collection("jobs").getFullList({
    sort: "-publishedAt",
    requestKey: "recruiter_jobs_list_full",
  }),
  jobApplicationCounts(pb),
]);
---

<RecruiterLayout title={`Jobs | ${companyName}`}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Jobs</h1>
      <p class="mt-1 text-sm text-slate-600">All roles including drafts and archived.</p>
    </div>
    <a class="btn-secondary btn-sm" href="/recruiter/applications">View applications inbox</a>
  </div>

  {
    errorMsg && (
      <p class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900">{errorMsg}</p>
    )
  }

  <ul class="mt-8 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
    {
      jobs.length === 0 ? (
        <li class="px-4 py-6 text-sm text-slate-600">No jobs yet.</li>
      ) : (
        jobs.map((job) => {
          const n = appCountByJob.get(job.id) ?? 0;
          const timing = jobPostingTimingLine(job, now);
          return (
            <li class="flex flex-col gap-4 px-4 py-5 sm:flex-row sm:items-start sm:justify-between">
              <div class="min-w-0 flex-1">
                <div class="text-lg font-semibold text-slate-900">{job.title}</div>
                <div class="mt-1 text-xs text-slate-500">{job.slug}</div>
                <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-600">
                  <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium capitalize text-slate-800">
                    {job.status}
                  </span>
                  <span>
                    <span class="font-medium text-slate-800">{n}</span> application{n === 1 ? "" : "s"}
                  </span>
                  {timing ? <span class="text-slate-600">{timing}</span> : null}
                </div>
              </div>
              <div class="flex flex-shrink-0 flex-wrap gap-2">
                <a class="btn-primary btn-sm" href={`/recruiter/jobs/${job.id}`}>
                  Job details
                </a>
                <a class="btn-secondary btn-sm" href={`/recruiter/jobs/${job.id}#applications`}>
                  Applications ({n})
                </a>
                <a class="btn-secondary btn-sm" href={`/recruiter/jobs/${job.id}#job-overview`}>
                  Description
                </a>
              </div>
            </li>
          );
        })
      )
    }
  </ul>
</RecruiterLayout>
