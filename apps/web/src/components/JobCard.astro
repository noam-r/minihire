---
import type { Job } from "../lib/jobs";
import { formatEmploymentType, formatWorkModel } from "../lib/jobs";

interface Props {
  job: Job;
}

const { job } = Astro.props;
---

<article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex flex-col gap-3">
    <div class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
      <span class="rounded-full bg-slate-100 px-3 py-1 font-medium text-slate-700">
        {formatWorkModel(job.workModel)}
      </span>
      <span>{formatEmploymentType(job.employmentType)}</span>
      {job.workLocation && <span>{job.workLocation}</span>}
    </div>

    <div class="space-y-2">
      <h2 class="text-xl font-semibold tracking-tight text-slate-900">
        <a class="hover:text-sky-700" href={`/jobs/${job.slug}`}>
          {job.title}
        </a>
      </h2>
      <p class="max-w-3xl text-sm leading-6 text-slate-600">{job.summary}</p>
    </div>

    <div class="pt-2">
      <a
        class="btn-primary btn-sm font-medium"
        href={`/jobs/${job.slug}`}
      >
        View role
      </a>
    </div>
  </div>
</article>
