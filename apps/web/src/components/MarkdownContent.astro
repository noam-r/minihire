---
import MarkdownIt from "markdown-it";

interface Props {
  content: string;
  class?: string;
}

const { content, class: className = "" } = Astro.props;

const md = new MarkdownIt({
  html: false,
  linkify: true,
  typographer: true,
});

const rendered = md.render(content);
---

<div class:list={["prose-jobs text-base leading-7 text-slate-700", className]} set:html={rendered} />
