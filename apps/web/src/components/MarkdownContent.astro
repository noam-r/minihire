---
import { renderReportMarkdownHtml } from "../lib/markdown-report";

interface Props {
  content: string;
  class?: string;
}

const { content, class: className = "" } = Astro.props;

const rendered = renderReportMarkdownHtml(content);
---

<div class:list={["prose-jobs text-base leading-7 text-slate-700", className]} set:html={rendered} />
