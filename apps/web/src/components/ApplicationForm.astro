---
import {
  FORM_SIGNATURE_FIELD,
  FORM_STARTED_AT_FIELD,
  HONEYPOT_FIELD_NAME,
} from "../lib/spam";

interface Props {
  jobSlug: string;
  formStartedAt: string;
  formSignature: string;
  maxCvSizeBytes: number;
}

const { jobSlug, formStartedAt, formSignature, maxCvSizeBytes } = Astro.props;
const maxCvSizeMegabytes = Math.round((maxCvSizeBytes / (1024 * 1024)) * 10) / 10;
---

<form
  id="application-form"
  class="space-y-6"
  action="/api/applications/submit"
  method="post"
  enctype="multipart/form-data"
  novalidate
>
  <input type="hidden" name="job_slug" value={jobSlug} />
  <input type="hidden" name={FORM_STARTED_AT_FIELD} value={formStartedAt} />
  <input type="hidden" name={FORM_SIGNATURE_FIELD} value={formSignature} />
  <div class="hidden" aria-hidden="true">
    <label for={HONEYPOT_FIELD_NAME}>Company website</label>
    <input id={HONEYPOT_FIELD_NAME} name={HONEYPOT_FIELD_NAME} type="text" tabindex="-1" autocomplete="off" />
  </div>

  <p class="rounded-xl border border-sky-100 bg-sky-50 px-4 py-3 text-sm text-slate-700">
    Fields marked <span class="font-semibold text-slate-900">*</span> are required. Everything else
    is optional.
  </p>

  <label class="block space-y-2">
    <span class="flex items-center gap-2 text-sm font-medium text-slate-900">
      <span>Full name</span>
      <span class="text-rose-700">*</span>
    </span>
    <input
      class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none ring-sky-500 transition focus:border-sky-500 focus:ring-2"
      type="text"
      name="full_name"
      maxlength="120"
      autocomplete="name"
      required
    />
    <span class="text-sm text-rose-700" data-error-for="full_name" aria-live="polite"></span>
  </label>

  <div class="grid gap-6 sm:grid-cols-2">
    <label class="block space-y-2">
      <span class="flex items-center gap-2 text-sm font-medium text-slate-900">
        <span>Email</span>
        <span class="text-rose-700">*</span>
      </span>
      <input
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none ring-sky-500 transition focus:border-sky-500 focus:ring-2"
        type="email"
        name="email"
        maxlength="254"
        autocomplete="email"
        required
      />
      <span class="text-sm text-rose-700" data-error-for="email" aria-live="polite"></span>
    </label>

    <label class="block space-y-2">
      <span class="flex items-center gap-2 text-sm font-medium text-slate-900">
        <span>Phone number</span>
        <span class="text-xs font-normal text-slate-500">Optional</span>
      </span>
      <input
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none ring-sky-500 transition focus:border-sky-500 focus:ring-2"
        type="tel"
        name="phone_number"
        maxlength="40"
        autocomplete="tel"
      />
      <span class="text-sm text-rose-700" data-error-for="phone_number" aria-live="polite"></span>
    </label>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <label class="block space-y-2">
      <span class="flex items-center gap-2 text-sm font-medium text-slate-900">
        <span>Location</span>
        <span class="text-xs font-normal text-slate-500">Optional</span>
      </span>
      <input
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none ring-sky-500 transition focus:border-sky-500 focus:ring-2"
        type="text"
        name="location"
        maxlength="120"
        autocomplete="address-level2"
      />
      <span class="text-sm text-rose-700" data-error-for="location" aria-live="polite"></span>
    </label>

    <label class="block space-y-2">
      <span class="flex items-center gap-2 text-sm font-medium text-slate-900">
        <span>Timezone</span>
        <span class="text-xs font-normal text-slate-500">Optional</span>
      </span>
      <input
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none ring-sky-500 transition focus:border-sky-500 focus:ring-2"
        type="text"
        name="timezone"
        maxlength="80"
        placeholder="UTC+2"
      />
      <span class="text-sm text-rose-700" data-error-for="timezone" aria-live="polite"></span>
    </label>
  </div>

  <div class="grid gap-6 sm:grid-cols-3">
    <label class="block space-y-2">
      <span class="flex items-center gap-2 text-sm font-medium text-slate-900">
        <span>GitHub URL</span>
        <span class="text-xs font-normal text-slate-500">Optional</span>
      </span>
      <input
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none ring-sky-500 transition focus:border-sky-500 focus:ring-2"
        type="url"
        name="github_url"
        maxlength="300"
        placeholder="https://github.com/you"
      />
      <span class="text-sm text-rose-700" data-error-for="github_url" aria-live="polite"></span>
    </label>

    <label class="block space-y-2">
      <span class="flex items-center gap-2 text-sm font-medium text-slate-900">
        <span>Portfolio URL</span>
        <span class="text-xs font-normal text-slate-500">Optional</span>
      </span>
      <input
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none ring-sky-500 transition focus:border-sky-500 focus:ring-2"
        type="url"
        name="portfolio_url"
        maxlength="300"
        placeholder="https://your-site.example"
      />
      <span class="text-sm text-rose-700" data-error-for="portfolio_url" aria-live="polite"></span>
    </label>

    <label class="block space-y-2">
      <span class="flex items-center gap-2 text-sm font-medium text-slate-900">
        <span>LinkedIn URL</span>
        <span class="text-xs font-normal text-slate-500">Optional</span>
      </span>
      <input
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none ring-sky-500 transition focus:border-sky-500 focus:ring-2"
        type="url"
        name="linkedin_url"
        maxlength="300"
        placeholder="https://linkedin.com/in/you"
      />
      <span class="text-sm text-rose-700" data-error-for="linkedin_url" aria-live="polite"></span>
    </label>
  </div>

  <label class="block space-y-2">
    <span class="flex items-center gap-2 text-sm font-medium text-slate-900">
      <span>Anything else you'd like to add?</span>
      <span class="text-xs font-normal text-slate-500">Optional</span>
    </span>
    <textarea
      class="min-h-40 w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none ring-sky-500 transition focus:border-sky-500 focus:ring-2"
      name="anything_else"
      maxlength="2000"
      placeholder="Share anything helpful that is not already covered by your CV."
    ></textarea>
    <span class="text-sm text-rose-700" data-error-for="anything_else" aria-live="polite"></span>
  </label>

  <label class="block space-y-2">
    <span class="flex items-center gap-2 text-sm font-medium text-slate-900">
      <span>
        CV upload <span class="text-slate-500">(PDF, .md, or .markdown, up to {maxCvSizeMegabytes} MB)</span>
      </span>
      <span class="text-rose-700">*</span>
    </span>
    <input
      class="block w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 file:mr-4 file:rounded-md file:border-0 file:bg-teal-700 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-teal-800"
      type="file"
      name="cv_file"
      accept=".pdf,.md,.markdown"
      required
    />
    <span class="text-sm text-rose-700" data-error-for="cv_file" aria-live="polite"></span>
  </label>

  <label class="flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 text-sm leading-6 text-slate-700">
    <input
      class="mt-1 h-4 w-4 rounded border-slate-300 text-sky-700 focus:ring-sky-500"
      type="checkbox"
      name="consent_to_store_data"
      value="true"
      required
    />
    <span>
      I consent to the storage and processing of my application data for evaluating this role.
      <span class="font-medium text-slate-900"> Required.</span>
      <span class="block text-rose-700" data-error-for="consent_to_store_data" aria-live="polite"></span>
    </span>
  </label>

  <div class="space-y-4">
    <p class="hidden rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800" id="form-error" aria-live="polite"></p>
    <button
      class="btn-primary btn-md disabled:cursor-not-allowed disabled:opacity-60"
      type="submit"
      id="submit-button"
    >
      Submit application
    </button>
  </div>
</form>

<script is:inline>
  const form = document.querySelector("#application-form");
  const submitButton = document.querySelector("#submit-button");
  const formError = document.querySelector("#form-error");

  if (form instanceof HTMLFormElement && submitButton instanceof HTMLButtonElement && formError instanceof HTMLElement) {
    const errorFields = Array.from(document.querySelectorAll("[data-error-for]"));

    const clearErrors = () => {
      formError.classList.add("hidden");
      formError.textContent = "";

      for (const element of errorFields) {
        element.textContent = "";
      }
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearErrors();

      submitButton.disabled = true;
      submitButton.textContent = "Submitting...";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
        });

        const payload = await response.json().catch(() => null);

        if (payload?.ok) {
          window.location.assign(`/jobs/${jobSlug}/apply/success`);
          return;
        }

        if (payload?.error === "VALIDATION_ERROR" && payload.fields) {
          Object.entries(payload.fields).forEach(([field, message]) => {
            const element = document.querySelector(`[data-error-for="${field}"]`);

            if (element instanceof HTMLElement && typeof message === "string") {
              element.textContent = message;
            }
          });

          formError.textContent = payload.message ?? "Please check the form and try again.";
        } else {
          formError.textContent = payload?.message ?? "Something went wrong. Please try again.";
        }

        formError.classList.remove("hidden");
      } catch {
        formError.textContent = "Something went wrong. Please try again.";
        formError.classList.remove("hidden");
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Submit application";
      }
    });
  }
</script>
