---
interface Props {
  class?: string;
  title?: string;
}

const { class: className = "h-4 w-4 shrink-0 text-amber-600", title } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 20 20"
  fill="currentColor"
  class={className}
  aria-hidden={title ? undefined : "true"}
  role={title ? "img" : undefined}
>
  {title && <title>{title}</title>}
  <path
    fill-rule="evenodd"
    d="M8.485 3.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 3.495zM10 6a.75.75 0 00-.75.75v3.5a.75.75 0 001.5 0v-3.5A.75.75 0 0010 6zm0 9a1 1 0 100-2 1 1 0 000 2z"
    clip-rule="evenodd"></path>
</svg>
