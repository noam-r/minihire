---
import type { ClarificationItemRecord, ClarificationRequestRecord } from "../../lib/clarification/types";
import { effectiveClarificationRequestStatus } from "../../lib/clarification/state";
import { formatSubmittedAt } from "../../lib/recruiter-application-display";
import { formatRelativeTime } from "../../lib/relative-time";

interface RequestWithItems {
  request: ClarificationRequestRecord;
  items: ClarificationItemRecord[];
}

interface Props {
  applicationId: string;
  history: RequestWithItems[];
  hasAiSuggestions: boolean;
  hasEmailFailed: boolean;
  activeRequest: ClarificationRequestRecord | null;
  undeliveredRequest: ClarificationRequestRecord | null;
  csrf: string;
  now: Date;
}

const {
  applicationId,
  history,
  hasAiSuggestions,
  hasEmailFailed,
  activeRequest,
  undeliveredRequest,
  csrf,
  now,
} = Astro.props;

const clarifyHref = `/recruiter/applications/${applicationId}/clarify`;
const clarifyLabel = hasAiSuggestions ? "Review and send" : "Clarify";

function statusLabel(status: string): string {
  switch (status) {
    case "sent":
      return "Waiting for candidate";
    case "opened":
      return "Waiting for answers";
    case "submitted":
      return "Completed";
    case "expired":
      return "Expired";
    case "cancelled":
      return "Cancelled";
    default:
      return status;
  }
}

function formatTs(value: string | undefined): string {
  if (!value) {
    return "—";
  }
  return formatSubmittedAt(value);
}
---

<section id="clarification" class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <header class="border-b border-slate-100 px-5 py-4">
    <h2 class="text-base font-semibold text-slate-900">Clarification</h2>
    <p class="mt-1 text-xs text-slate-500">Follow-up questions sent to the candidate.</p>
  </header>

  <div class="space-y-6 px-5 py-4">
    {
      undeliveredRequest && (
        <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
          <p class="text-sm font-medium text-amber-950">Email not sent</p>
          <p class="mt-2 text-sm text-amber-900">
            Clarification questions were saved, but the candidate did not receive an email. You can
            send the email now or cancel and start over.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <form method="post" action="/recruiter/actions/resend-clarification" class="inline">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="application_id" value={applicationId} />
              <input type="hidden" name="request_id" value={undeliveredRequest.id} />
              <button type="submit" class="btn-primary btn-sm">Send email to candidate</button>
            </form>
            <form method="post" action="/recruiter/actions/cancel-undelivered-clarification" class="inline">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="application_id" value={applicationId} />
              <input type="hidden" name="request_id" value={undeliveredRequest.id} />
              <button type="submit" class="btn-secondary btn-sm">Cancel and start over</button>
            </form>
          </div>
        </div>
      )
    }

    {
      !activeRequest && !undeliveredRequest && history.length === 0 && (
        <div>
          <p class="text-sm text-slate-600">No clarification requested yet.</p>
          {
            hasEmailFailed && (
              <p class="mt-2 text-sm text-amber-800">
                The last clarification email could not be sent. You can try again.
              </p>
            )
          }
          <a class="btn-primary btn-sm mt-4 inline-flex no-underline" href={clarifyHref}>
            {clarifyLabel}
          </a>
        </div>
      )
    }

    {
      activeRequest && (
        <div class="rounded-lg border border-slate-200 bg-slate-50/80 p-4">
          <p class="text-sm font-medium text-slate-900">Clarification requested</p>
          <dl class="mt-3 space-y-2 text-sm text-slate-700">
            <div class="flex flex-wrap justify-between gap-2">
              <dt class="text-slate-500">Sent</dt>
              <dd title={formatTs(activeRequest.sent_at)}>
                {formatRelativeTime(activeRequest.sent_at, now)}
              </dd>
            </div>
            <div class="flex flex-wrap justify-between gap-2">
              <dt class="text-slate-500">Opened</dt>
              <dd title={activeRequest.seen_at ? formatTs(activeRequest.seen_at) : undefined}>
                {activeRequest.seen_at ? formatRelativeTime(activeRequest.seen_at, now) : "Not yet"}
              </dd>
            </div>
            <div class="flex flex-wrap justify-between gap-2">
              <dt class="text-slate-500">Status</dt>
              <dd>{statusLabel(effectiveClarificationRequestStatus(activeRequest, now))}</dd>
            </div>
          </dl>
        </div>
      )
    }

    {
      history.map(({ request, items }) => {
        const effective = effectiveClarificationRequestStatus(request, now);
        const isSubmitted = effective === "submitted";
        const isFailed =
          request.status === "cancelled" && request.cancel_reason === "candidate_email_failed";
        const isExpired = effective === "expired";
        const isActive =
          (activeRequest && activeRequest.id === request.id) ||
          (undeliveredRequest && undeliveredRequest.id === request.id);

        if (isActive && !isSubmitted) {
          return null;
        }

        return (
          <article class="border-t border-slate-100 pt-5 first:border-0 first:pt-0">
            {
              isSubmitted ? (
                <>
                  <p class="text-sm font-medium text-slate-900">Clarification completed</p>
                  <p class="mt-2 text-xs text-slate-500">
                    Sent:{" "}
                    <span title={formatTs(request.sent_at)}>{formatRelativeTime(request.sent_at, now)}</span>
                    {" · "}
                    Opened:{" "}
                    <span title={request.seen_at ? formatTs(request.seen_at) : undefined}>
                      {request.seen_at ? formatRelativeTime(request.seen_at, now) : "—"}
                    </span>
                    {" · "}
                    Submitted:{" "}
                    <span title={formatTs(request.submitted_at)}>
                      {formatRelativeTime(request.submitted_at, now)}
                    </span>
                  </p>
                  <div class="mt-4 space-y-4">
                    {items.map((item) => (
                      <div class="text-sm">
                        <p class="font-medium text-slate-800">Q: {item.question_text}</p>
                        <p class="mt-1 whitespace-pre-wrap text-slate-700">A: {item.answer_text ?? "—"}</p>
                      </div>
                    ))}
                  </div>
                </>
              ) : isFailed ? (
                <p class="text-sm text-amber-800">
                  A clarification request could not be emailed to the candidate (
                  {formatRelativeTime(request.cancelled_at ?? request.sent_at, now)}).
                </p>
              ) : isExpired ? (
                <p class="text-sm text-slate-600">
                  Clarification link expired (
                  <span title={formatTs(request.expires_at)}>{formatRelativeTime(request.expires_at, now)}</span>
                  ).
                </p>
              ) : null
            }
          </article>
        );
      })
    }

    {
      !activeRequest && !undeliveredRequest && history.length > 0 && (
        <div>
          {
            hasEmailFailed && (
              <p class="mb-3 text-sm text-amber-800">
                The last clarification email could not be sent. You can try again.
              </p>
            )
          }
          <a class="btn-secondary btn-sm inline-flex no-underline" href={clarifyHref}>
            {clarifyLabel}
          </a>
        </div>
      )
    }
  </div>
</section>
