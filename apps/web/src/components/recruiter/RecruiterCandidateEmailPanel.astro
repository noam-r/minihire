---
import type { RecruiterCandidateEmailLogRecord } from "../../lib/recruiter-candidate-email/types";
import { formatRecruiterCandidateEmailLogLabel } from "../../lib/recruiter-candidate-email/types";
import { formatRelativeTime } from "../../lib/relative-time";

interface Props {
  applicationId: string;
  history: RecruiterCandidateEmailLogRecord[];
  now: Date;
}

const { applicationId, history, now } = Astro.props;

function previewBody(body: string | undefined, max = 120): string {
  const text = String(body ?? "").trim().replace(/\s+/g, " ");
  if (!text) {
    return "";
  }
  if (text.length <= max) {
    return text;
  }
  return `${text.slice(0, max)}…`;
}
---

<section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <header class="border-b border-slate-100 px-5 py-3">
    <h2 class="text-sm font-semibold text-slate-900">Email candidate</h2>
    <p class="mt-0.5 text-xs text-slate-500">
      Send rejection or free-text messages. For questions with a reply form, use Clarification below.
    </p>
  </header>
  <div class="space-y-4 px-5 py-4">
    <a
      class="btn-primary btn-sm inline-flex w-full justify-center no-underline"
      href={`/recruiter/applications/${applicationId}/email`}
    >
      Send email
    </a>

    {
      history.length === 0 ? (
        <p class="text-sm text-slate-500">No emails sent yet.</p>
      ) : (
        <ul class="max-h-56 space-y-3 overflow-y-auto pr-1 text-sm">
          {
            history.map((entry) => {
              const preview = previewBody(entry.body);
              return (
                <li class="rounded-lg border border-slate-100 bg-slate-50/80 px-3 py-2">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-medium text-slate-900">
                      {formatRecruiterCandidateEmailLogLabel(entry.template)}
                    </span>
                    <span
                      class:list={[
                        "inline-flex rounded-full px-2 py-0.5 text-xs font-medium",
                        entry.status === "sent"
                          ? "bg-teal-50 text-teal-900"
                          : "bg-red-50 text-red-800",
                      ]}
                    >
                      {entry.status === "sent" ? "Sent" : "Failed"}
                    </span>
                    <span class="text-xs text-slate-500">{formatRelativeTime(entry.created, now)}</span>
                  </div>
                  {entry.subject && <p class="mt-1 text-xs text-slate-600">{entry.subject}</p>}
                  {preview && <p class="mt-1 text-xs leading-relaxed text-slate-500">{preview}</p>}
                  {
                    entry.status === "failed" && entry.error_message && (
                      <p class="mt-1 text-xs text-red-700">{entry.error_message}</p>
                    )
                  }
                </li>
              );
            })
          }
        </ul>
      )
    }
  </div>
</section>
